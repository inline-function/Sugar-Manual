                        Box(modifier = weight(1.0), orientation = "vertical", spacing = 2) {
                            Text(text = "舍曲林", size = 16, bold = true, color = "onSurface")
                            Text(text = "处方药 · T½ 26h · F=44% · 口服", size = 12, color = "onSurfaceVariant")
                        }
                        Box(modifier = paddingH(4), onClick = { unchecked openDocFor(3) }) {
                            Text(text = "ⓘ", size = 13, bold = true, color = "onSurfaceVariant")
                        }
                        Box(modifier = paddingH(8), visible = isSel(3)) {
                            Text(text = "✓", size = 16, bold = true, color = "primary")
                        }
                    }

                    Box(modifier = fillWidth().clip(12).paddingHV(12, 10), orientation = "horizontal", contentAlignment = CenterStart(), backgroundColor = "surfaceVariant", onClick = { unchecked pickDrugAt(4) }) {
