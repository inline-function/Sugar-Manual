                            Text(text = name2(), modifier = weight(1.0), size = 16, bold = true, color = "onSurface")
                            Text(text = dose2(), size = 16, bold = true, color = "primary")
                        }
                        Box(modifier = height(4)) {}
                        Text(text = time2(), color = "onSurfaceVariant", size = 12)
                    }
