// home.subl —— 首页 @compose 视图（契约 §2：编译期展开为 gen/ 下真 Kotlin Compose）
//
// 与 main.subl 的 content() 同构：顶栏 / 浓度图（45%）/ 预警标签流 / 记录卡 / FAB。
// 交互（契约 §4 交互态）：发射器把 `unchecked f(args)` 形的 onClick lambda 抽成路由名，
// 宿主 DshComposeHost.act/boolArg/strArg 在 Kotlin 侧持交互态（formOpen/选中行/剂量/校验错误），
// 与 main.subl 的 JS 逻辑同语义、storage 同源（ledger 写同一 SharedPreferences）。
// 表单细节 1:1 对齐 Kotlin 参考 DoseEntrySheet.kt：选药行副标题（管理类·T½·F·给药途径）、
// 选中行 ✓、OutlinedTextField label+isError+supportingText、四级校验、AlertDialog 文档/设置。

@compose
struct Home {
    Box(modifier = fillMaxSize()) {
        TopAppBar(title = "语法糖手册", subtitle = "V1.0") {
            TextButton(onClick = { unchecked openDrugList() }) {
                Icon(name = "info", size = 22, tint = "onPrimary")
            }
            TextButton(onClick = { unchecked openDrugList() }) {
                Icon(name = "menu", size = 22, tint = "onPrimary")
            }
            TextButton(onClick = { unchecked openSettingsDialog() }) {
                Icon(name = "settings", size = 22, tint = "onPrimary")
            }
        }
        Chart(
            kind = "line",
            // 数据槽（宿主态机）：labels/total/series 由 DshComposeHost 依 ledger 运行时计算
            // （与 JS chartSeriesList/PkEngine 同公式；空台账→氟伏沙明演示序列）
            labels = chartLabels(),
            points = chartTotal(),
            series = chartSeries(),
            color = "primary",
            legend = true,
            badge = "估算",
            modifier = fillWidth().fractionHeight(0.45)
        )
        Box(modifier = fillWidth().weight(1.0), scrollable = true) {
            // 预警标签流（无标题，位于图表与记录之间）：主观效应词条 —— 联用药品的急性/慢性
            // 不良反应跨药聚合，三级配色（白 → 黄 → 红，越深越重）、急性词条闪烁；
            // 「血清素综合征」「阿片类中毒」为综合征包（◆ 标记）。宿主机 effectTags() 按同源
            // 引擎（warn.subl）计算；@compose 无列表槽，同步时把 EFFECTTAGS_HOST 标记替换为
            // Subl_EffectTags(tags = DshComposeHost.effectTags())。
            Box(modifier = fillWidth().padding4(24, 10, 24, 8)) {
                Text(text = "EFFECTTAGS_HOST", size = 1)
            }
            Box(modifier = fillWidth(), visible = hasRec(0)) {
                Card(modifier = fillWidth().paddingH(24).paddingV(6), cornerRadius = 12, elevation = 0, backgroundColor = "surfaceVariant") {
                    Box(modifier = fillWidth().paddingHV(16, 12)) {
                        Box(modifier = fillWidth(), orientation = "horizontal") {
                            Box(modifier = width(10)) {}
                            Text(text = name0(), modifier = weight(1.0), size = 16, bold = true, color = "onSurface")
                            Text(text = dose0(), size = 16, bold = true, color = "primary")
                        }
                        Box(modifier = height(4)) {}
                        Text(text = time0(), color = "onSurfaceVariant", size = 12)
                    }
                }
            }
            Box(modifier = fillWidth(), visible = hasRec(1)) {
                Card(modifier = fillWidth().paddingH(24).paddingV(6), cornerRadius = 12, elevation = 0, backgroundColor = "surfaceVariant") {
                    Box(modifier = fillWidth().paddingHV(16, 12)) {
                        Box(modifier = fillWidth(), orientation = "horizontal") {
                            Box(modifier = width(10)) {}
                            Text(text = name1(), modifier = weight(1.0), size = 16, bold = true, color = "onSurface")
                            Text(text = dose1(), size = 16, bold = true, color = "primary")
                        }
                        Box(modifier = height(4)) {}
                        Text(text = time1(), color = "onSurfaceVariant", size = 12)
                    }
                }
            }
            Box(modifier = fillWidth(), visible = hasRec(2)) {
