                        }
                        Box(modifier = paddingH(8), visible = isSel(11)) {
                            Text(text = "✓", size = 16, bold = true, color = "primary")
                        }
                    }

                    Box(modifier = fillWidth().clip(12).paddingHV(12, 10), orientation = "horizontal", contentAlignment = CenterStart(), backgroundColor = "surfaceVariant", onClick = { unchecked pickDrugAt(12) }) {
                        Box(modifier = weight(1.0), orientation = "vertical", spacing = 2) {
                            Text(text = "吗啡", size = 16, bold = true, color = "onSurface")
                            Text(text = "处方药 · T½ 2h · F=34% · 口服", size = 12, color = "onSurfaceVariant")
                        }
                        Box(modifier = paddingH(8), visible = isSel(12)) {
                            Text(text = "✓", size = 16, bold = true, color = "primary")
                        }
                    }

                    Box(modifier = fillWidth().clip(12).paddingHV(12, 10), orientation = "horizontal", contentAlignment = CenterStart(), backgroundColor = "surfaceVariant", onClick = { unchecked pickDrugAt(13) }) {
                        Box(modifier = weight(1.0), orientation = "vertical", spacing = 2) {
                            Text(text = "羟考酮", size = 16, bold = true, color = "onSurface")
                            Text(text = "处方药 · T½ 4h · F≈87% · 口服", size = 12, color = "onSurfaceVariant")
                        }
                        Box(modifier = paddingH(8), visible = isSel(13)) {
                            Text(text = "✓", size = 16, bold = true, color = "primary")
                        }
                    }

                    Box(modifier = fillWidth().clip(12).paddingHV(12, 10), orientation = "horizontal", contentAlignment = CenterStart(), backgroundColor = "surfaceVariant", onClick = { unchecked pickDrugAt(14) }) {
                        Box(modifier = weight(1.0), orientation = "vertical", spacing = 2) {
                            Text(text = "芬太尼", size = 16, bold = true, color = "onSurface")
                            Text(text = "处方药 · T½ 17h · F≈92% · 透皮", size = 12, color = "onSurfaceVariant")
                        }
                        Box(modifier = paddingH(8), visible = isSel(14)) {
                            Text(text = "✓", size = 16, bold = true, color = "primary")
                        }
                    }

                    Box(modifier = fillWidth().clip(12).paddingHV(12, 10), orientation = "horizontal", contentAlignment = CenterStart(), backgroundColor = "surfaceVariant", onClick = { unchecked pickDrugAt(15) }) {
                        Box(modifier = weight(1.0), orientation = "vertical", spacing = 2) {
                            Text(text = "可待因", size = 16, bold = true, color = "onSurface")
                            Text(text = "处方药 · T½ 3h · F≈60% · 口服", size = 12, color = "onSurfaceVariant")
                        }
                        Box(modifier = paddingH(8), visible = isSel(15)) {
                            Text(text = "✓", size = 16, bold = true, color = "primary")
                        }
                    }

                    Box(modifier = fillWidth().clip(12).paddingHV(12, 10), orientation = "horizontal", contentAlignment = CenterStart(), backgroundColor = "surfaceVariant", onClick = { unchecked pickDrugAt(16) }) {
                        Box(modifier = weight(1.0), orientation = "vertical", spacing = 2) {
                            Text(text = "曲马多", size = 16, bold = true, color = "onSurface")
                            Text(text = "处方药 · T½ 6h · F=66% · 口服", size = 12, color = "onSurfaceVariant")
                        }
                        Box(modifier = paddingH(8), visible = isSel(16)) {
