@compose
struct PickerRowsA {
    Box(modifier = fillWidth(), orientation = "vertical", spacing = 6) {
                    Box(modifier = fillWidth().clip(12).paddingHV(12, 10), orientation = "horizontal", contentAlignment = CenterStart(), backgroundColor = "surfaceVariant", onClick = { unchecked pickDrugAt(0) }) {
                        Box(modifier = weight(1.0), orientation = "vertical", spacing = 2) {
                            Text(text = "氟伏沙明", size = 16, bold = true, color = "onSurface")
                            Text(text = "处方药 · T½ 15h · F=50% · 口服", size = 12, color = "onSurfaceVariant")
                        }
                        Box(modifier = paddingH(4), onClick = { unchecked openDocFor(0) }) {
                            Text(text = "ⓘ", size = 13, bold = true, color = "onSurfaceVariant")
                        }
                        Box(modifier = paddingH(8), visible = isSel(0)) {
                            Text(text = "✓", size = 16, bold = true, color = "primary")
                        }
                    }

                    Box(modifier = fillWidth().clip(12).paddingHV(12, 10), orientation = "horizontal", contentAlignment = CenterStart(), backgroundColor = "surfaceVariant", onClick = { unchecked pickDrugAt(1) }) {
                        Box(modifier = weight(1.0), orientation = "vertical", spacing = 2) {
                            Text(text = "帕罗西汀", size = 16, bold = true, color = "onSurface")
                            Text(text = "处方药 · T½ 24h · F=100% · 口服", size = 12, color = "onSurfaceVariant")
                        }
                        Box(modifier = paddingH(4), onClick = { unchecked openDocFor(1) }) {
                            Text(text = "ⓘ", size = 13, bold = true, color = "onSurfaceVariant")
                        }
                        Box(modifier = paddingH(8), visible = isSel(1)) {
                            Text(text = "✓", size = 16, bold = true, color = "primary")
                        }
                    }

                    Box(modifier = fillWidth().clip(12).paddingHV(12, 10), orientation = "horizontal", contentAlignment = CenterStart(), backgroundColor = "surfaceVariant", onClick = { unchecked pickDrugAt(2) }) {
                        Box(modifier = weight(1.0), orientation = "vertical", spacing = 2) {
                            Text(text = "氟西汀", size = 16, bold = true, color = "onSurface")
                            Text(text = "处方药 · T½ 96h · F≈60% · 口服", size = 12, color = "onSurfaceVariant")
                        }
                        Box(modifier = paddingH(4), onClick = { unchecked openDocFor(2) }) {
                            Text(text = "ⓘ", size = 13, bold = true, color = "onSurfaceVariant")
                        }
                        Box(modifier = paddingH(8), visible = isSel(2)) {
