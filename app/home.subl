// home.subl —— 首页 @compose 视图（契约 §2：编译期展开为 gen/ 下真 Kotlin Compose）
//
// 与 main.subl 的 content() 同构：顶栏 / 浓度图（45%）/ 预警标签流 / 记录卡 / FAB。
// 交互（契约 §4 交互态）：发射器把 `unchecked f(args)` 形的 onClick lambda 抽成路由名，
// 宿主 DshComposeHost.act/boolArg/strArg 在 Kotlin 侧持交互态（formOpen/选中行/剂量/校验错误），
// 与 main.subl 的 JS 逻辑同语义、storage 同源（ledger 写同一 SharedPreferences）。
// 表单细节 1:1 对齐 Kotlin 参考 DoseEntrySheet.kt：选药行副标题（管理类·T½·F·给药途径）、
// 选中行 ✓、OutlinedTextField label+isError+supportingText、四级校验、AlertDialog 文档/设置。

@compose
struct Home {
    Box(modifier = fillMaxSize()) {
        TopAppBar(title = "语法糖手册", subtitle = "V1.0") {
            TextButton(onClick = { unchecked openDocDialog() }) {
                Icon(name = "info", size = 22, tint = "onPrimary")
            }
            TextButton(onClick = { unchecked noNavigation() }) {
                Icon(name = "menu", size = 22, tint = "onPrimary")
            }
            TextButton(onClick = { unchecked openSettingsDialog() }) {
                Icon(name = "settings", size = 22, tint = "onPrimary")
            }
        }
        Chart(
            kind = "line",
            labels = listOf("0", "12", "24", "36", "48"),
            points = listOf(50.0, 41.6, 34.5, 28.7, 23.9, 19.8, 66.5, 55.3, 46.0, 38.2, 31.7, 26.4, 22.0),
            series = listOf(Series(label = "氟伏沙明", color = "#FFC107", points = listOf(50.0, 41.6, 34.5, 28.7, 23.9, 19.8, 66.5, 55.3, 46.0, 38.2, 31.7, 26.4, 22.0))),
            color = "primary",
            legend = true,
            badge = "估算",
            modifier = fillWidth().fractionHeight(0.45)
        )
        Box(modifier = fillWidth().weight(1.0), scrollable = true) {
            Box(modifier = fillWidth().paddingHV(24, 8)) {
                Box(modifier = fillWidth(), orientation = "vertical", spacing = 8) {
                    Text(text = "联用预警", size = 16, bold = true, color = "onSurface")
                    Box(modifier = fillWidth(), wrap = true, spacing = 8) {
                        Box(modifier = clip(12).background("#33D32F2F").paddingHV(12, 5)) {
                            Text(text = "恶心", color = "#C62828", size = 14, bold = true)
                        }
                        Box(modifier = clip(12).background("#33F9A825").paddingHV(12, 5)) {
                            Text(text = "失眠", color = "#E65100", size = 14, bold = true)
                        }
                        Box(modifier = clip(12).background("#33F9A825").paddingHV(12, 5)) {
                            Text(text = "嗜睡", color = "#E65100", size = 14, bold = true)
                        }
                        Box(modifier = clip(12).background("#3355595F").paddingHV(12, 5)) {
                            Text(text = "头晕", color = "#44464F", size = 14, bold = true)
                        }
                    }
                }
            }
            Box(modifier = fillWidth().padding4(24, 16, 24, 8)) {
                Text(text = "服药记录", size = 16, bold = true, color = "onSurface")
            }
            Card(modifier = fillWidth().paddingH(24).paddingV(6), cornerRadius = 12, elevation = 0, backgroundColor = "surfaceVariant") {
                Box(modifier = fillWidth().paddingHV(16, 12)) {
                    Box(modifier = fillWidth(), orientation = "horizontal") {
                        Box(modifier = width(4).height(20).background("#FFC107")) {}
                        Box(modifier = width(10)) {}
                        Text(text = doseDrug(), modifier = weight(1.0), size = 16, bold = true, color = "onSurface")
                        Text(text = doseAmount(), size = 16, bold = true, color = "primary")
                    }
                    Box(modifier = height(4)) {}
                    Text(text = doseTime(), color = "onSurfaceVariant", size = 12)
                }
            }
            Box(modifier = fillWidth().paddingH(24).paddingV(12), contentAlignment = Center()) {
                Text(text = "演示数据：空台账时按示范剂量展示，记录服药后由逻辑层驱动", color = "onSurfaceVariant", size = 12)
            }
            Box(modifier = height(96)) {}
        }
        BottomSheet(visible = isFormOpen(), onDismiss = { unchecked cancelForm() }) {
            Box(modifier = fillWidth().paddingHV(24, 16), orientation = "vertical", spacing = 12) {
                Text(text = "＋服用药物", size = 22, bold = true, color = "onSurface")
                Text(text = "选择药物并填写剂量（mg）", size = 12, color = "onSurfaceVariant")
                Text(text = "药物", size = 14, color = "onSurfaceVariant")
                Box(modifier = fillWidth(), orientation = "vertical", spacing = 6) {
                    Box(modifier = fillWidth().clip(12).paddingHV(12, 10), orientation = "horizontal", contentAlignment = CenterStart(), backgroundColor = "surfaceVariant", onClick = { unchecked pickDrugAt(0) }) {
                        Box(modifier = weight(1.0), orientation = "vertical", spacing = 2) {
                            Text(text = "氟伏沙明", size = 16, bold = true, color = "onSurface")
                            Text(text = "处方药 · T½ 15h · F=50% · 口服", size = 12, color = "onSurfaceVariant")
                        }
                        Box(modifier = paddingH(8), visible = isSel(0)) {
                            Text(text = "✓", size = 16, bold = true, color = "primary")
                        }
                    }
                    Box(modifier = fillWidth().clip(12).paddingHV(12, 10), orientation = "horizontal", contentAlignment = CenterStart(), backgroundColor = "surfaceVariant", onClick = { unchecked pickDrugAt(1) }) {
                        Box(modifier = weight(1.0), orientation = "vertical", spacing = 2) {
                            Text(text = "帕罗西汀", size = 16, bold = true, color = "onSurface")
                            Text(text = "处方药 · T½ 24h · F=100% · 口服", size = 12, color = "onSurfaceVariant")
                        }
                        Box(modifier = paddingH(8), visible = isSel(1)) {
                            Text(text = "✓", size = 16, bold = true, color = "primary")
                        }
                    }
                }
                TextField(placeholder = "剂量 (mg)", label = "剂量 (mg)", text = curDose(), errText = doseErr(), keyboard = "number", onChange = { t => unchecked setDose(t) })
                Box(modifier = fillWidth(), orientation = "horizontal", arrangement = "End", spacing = 8) {
                    TextButton(label = "取消", onClick = { unchecked cancelForm() }) {}
                    Button(label = "确认", onClick = { unchecked commitDose() }) {}
                }
            }
        }
        AlertDialog(visible = isSettingsOpen(), title = "设置", confirmText = "清空记录", dismissText = "关闭", onConfirm = { unchecked clearAll() }, onDismiss = { unchecked closeSettings() }) {
            Box(modifier = fillWidth(), orientation = "vertical", spacing = 8) {
                Text(text = "语法糖手册 V1.0", size = 16, bold = true, color = "onSurface")
                Text(text = "SfA（Sublimation for Android）@compose 通路演示\n按钮交互经 DshComposeHost.act 路由到 Kotlin 侧交互态。", color = "onSurfaceVariant", size = 12)
            }
        }
        AlertDialog(visible = isDocOpen(), title = "药物说明", confirmText = "知道了", dismissText = "关闭", onConfirm = { unchecked closeDoc() }, onDismiss = { unchecked closeDoc() }) {
            Box(modifier = fillWidth(), orientation = "vertical", spacing = 8) {
                Text(text = "氟伏沙明 / 帕罗西汀", size = 16, bold = true, color = "onSurface")
                Text(text = "演示子集：SSRI 联用，CYP2D6 抑制-底物相互作用；T½ 与 F 按演示资料。", color = "onSurfaceVariant", size = 12)
            }
        }
        FloatingButton(icon = "add", text = "＋服用药物", color = "primary", onClick = { unchecked toggleForm() })
    }
}
