                TextField(placeholder = "剂量 (mg)", label = "剂量 (mg)", text = curDose(), errText = doseErr(), keyboard = "number", onChange = { t => unchecked setDose(t) })
                Box(modifier = fillWidth(), orientation = "horizontal", arrangement = "End", spacing = 8) {
