            }
            Box(modifier = height(96)) {}
        }
        BottomSheet(visible = isFormOpen(), onDismiss = { unchecked cancelForm() }) {
            Box(modifier = fillWidth().paddingHV(24, 16), orientation = "vertical", spacing = 12) {
                Text(text = "＋服用药物", size = 22, bold = true, color = "onSurface")
                Text(text = "选择药物并填写剂量（mg）；代谢物条目仅资料页，不入选", size = 12, color = "onSurfaceVariant")
                Text(text = "药物", size = 14, color = "onSurfaceVariant")
                Box(modifier = fillWidth().height(240), scrollable = true) {
