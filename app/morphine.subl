// app/morphine.subl —— 吗啡完整资料
// 数值来源：药品说明书与 PubMed 10201674（口服生物利用度 34±9%，肠吸收约 82%、
// 肝首过约 42%）。halfLife=2h（2-4h）；代谢以 UGT2B7 葡萄糖醛酸化为主，不经 CYP。

fun morphine(): Drug = Drug(
    name = "吗啡",
    category = "处方药",
    tags = strList("阿片类,强阿片镇痛药,麻醉性镇痛药,麻醉药品（管制）"),
    description = "吗啡是天然阿片生物碱（罂粟）、μ/κ 阿片受体完全激动剂，重度疼痛（癌痛、急性锐痛、急性肺水肿伴呼吸困难）的金标准。口服因高首过代谢生物利用度低（约 34%）；主要经 UGT2B7 葡萄糖醛酸化为活性代谢物 M6G（强 μ 激动，蓄积可致延迟呼吸抑制）与 M3G（可能致神经毒性）。与苯二氮卓类、乙醇或其他中枢抑制剂联用可致致命呼吸抑制（FDA 黑框警告）；长期使用产生耐受、生理依赖与便秘（持续不耐受）。严格按麻醉药品管理。",
    effects = ratedList("强效|μ-阿片受体激动;中效|κ-阿片受体激动;强效|脊髓与中枢痛传导抑制"),
    enzymes = strList("UGT2B7"),
    inhibitions = emptyList(),
    pk = cons(PkProfile(
        route = "口服", form = "常释", halfLife = 2, tmax = "1-2h",
        clearance = "一级（肝葡萄糖醛酸化）", curve = "对数", bio = 0.34,
        metabolites = cons(Rated("强效", "M6G 吗啡-6-葡萄糖醛酸（活性 μ 激动）"), cons(Rated("极弱", "M3G 吗啡-3-葡萄糖醛酸（可能致神经毒性）"), emptyList()))
    ), emptyList()),
    acuteTher = ratedList("强效|镇痛（急性锐痛）;强效|镇静;中效|急性肺水肿呼吸困难缓解"),
    chronicTher = ratedList("强效|镇痛（癌痛）;强效|镇痛（慢性重度疼痛）"),
    acuteAdv = ratedList("常见|呼吸抑制;十分常见|镇静;常见|恶心呕吐;常见|血压下降（血容量不足）;常见|欣快"),
    chronicAdv = ratedList("十分常见|便秘;十分常见|嗜睡;常见|恶心;常见|呕吐;常见|呼吸抑制;常见|口干;常见|尿潴留;常见|瘙痒;常见|瞳孔缩小;常见|耐受（长期使用）;常见|依赖（长期使用）;少见|肌阵挛;少见|免疫抑制（长期）"),
    withdraw = ratedList("十分常见|阿片戒断综合征（骤停）;常见|流泪流涕;常见|出汗;常见|肌痛;常见|瞳孔散大;常见|焦虑;常见|失眠"),
    overdose = ratedList(">60mg|呼吸抑制（急性，纳洛酮可拮抗）")
)
