// app/吗氯贝胺.subl —— 吗氯贝胺完整资料（t92 回迁：原仅存于宿主 Kotlin，现回归 subl 源）
// 数值来源：宿主 DshComposeHost docText/结构化表（宿主 docText 药代段）；吗氯贝胺说明书级数据的药理整合见描述段。
fun moclobemide(): Drug = Drug(
    name = "吗氯贝胺",
    category = "处方药",
    tags = strList("MAOIs，可逆性单胺氧化酶A抑制剂，RIMA，抗抑郁药，血清素能，去甲肾上腺素能"),
    description = "吗氯贝胺是可逆性、选择性 MAO-A 抑制剂（RIMA），用于抑郁症。对 MAO-A 的抑制短促可逆，富酪胺食物（奶酪、腌肉、葡萄酒）引起的高血压危象风险远低于不可逆 MAOI，但仍需谨慎；与血清素能药（SSRIs、曲马多、右美沙芬、哌甲酯）联用可致血清素综合征，须洗脱。肝功能不全减量。",
    effects = ratedList("强效|MAO-A 抑制"),
    enzymes = emptyList(),
    inhibitions = emptyList(),
    pk = cons(PkProfile(
        route = "口服", form = "常释", halfLife = 2, tmax = "",
        clearance = "一级（肝代谢）", curve = "对数", bio = 0.9,
        metabolites = emptyList(),
        activeForms = emptyList()
    ), emptyList()),
    acuteTher = emptyList(),
    chronicTher = ratedList("强效|抗抑郁"),
    acuteAdv = ratedList("常见|失眠、恶心"),
    chronicAdv = ratedList("少见|肝损伤"),
    withdraw = emptyList(),
    overdose = ratedList(">300mg单次|过量风险"),
    admin = "口服"
)
