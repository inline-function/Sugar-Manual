// app/fentanyl.subl —— 芬太尼完整资料
// 数值来源：药品说明书（透皮系统）。halfLife=17h 为透皮系统移除后的表观终末
// 半衰期；bio=0.92 为透皮吸收率；剂量以「贴片 72 小时累计释放量 mg」计。
// CYP3A4 为主要代谢酶。

fun fentanyl(): Drug = Drug(
    name = "芬太尼",
    category = "处方药",
    tags = strList("阿片类,强阿片镇痛药,合成苯基哌啶类,麻醉药品（管制）,透皮给药"),
    description = "芬太尼是合成苯基哌啶类 μ 阿片受体强激动剂（效价约为吗啡 75-100 倍），用于麻醉辅助（静脉）、重度癌痛（透皮贴片）与穿透性疼痛（粘膜制剂）。透皮贴片 12.5-100 μg/h、每 72 小时更换，达稳态需 12-24 小时，撤贴后表观半衰期约 17 小时；剂量按 72 小时累计释放量（mg）估算。主要经 CYP3A4 快速失活，与 CYP3A4 抑制剂（克拉霉素、伏立康唑、利托那韦）合用血药浓度可数倍升高致死；纳洛酮拮抗需重复给药（脂库再分布）。与苯二氮卓类合用呼吸抑制风险（FDA 黑框警告）。按麻醉药品严格管理。",
    effects = ratedList("极强效|μ-阿片受体激动;强效|镇痛（效价高）"),
    enzymes = strList("CYP3A4"),
    inhibitions = emptyList(),
    pk = cons(PkProfile(
        route = "透皮", form = "缓释贴片（72h）", halfLife = 17, tmax = "贴后 12-24h 达稳",
        clearance = "一级（CYP3A4 去甲基化）", curve = "对数（贴用期零级吸收，撤贴后一级消除）", bio = 0.92,
        metabolites = emptyList()
    ), emptyList()),
    acuteTher = ratedList("极强效|镇痛（急性重度）;强效|麻醉辅助（静脉）"),
    chronicTher = ratedList("极强效|镇痛（癌痛）;强效|镇痛（慢性重度疼痛）"),
    acuteAdv = ratedList("常见|呼吸抑制;十分常见|镇静;常见|胸壁强直（大剂量快推）;常见|恶心呕吐"),
    chronicAdv = ratedList("十分常见|便秘;十分常见|嗜睡;常见|呼吸抑制;常见|瘙痒（尤为常见）;常见|恶心;常见|呕吐;常见|出汗;常见|耐受（持续使用）;常见|依赖（持续使用）;少见|低血压;少见|撤贴反跳痛"),
    withdraw = ratedList("十分常见|阿片戒退综合征（骤停）;常见|出汗;常见|肌痛;常见|焦虑;常见|失眠"),
    overdose = ratedList(">4mg|呼吸抑制（纳洛酮需重复给药）")
)
