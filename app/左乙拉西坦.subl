    effects = ratedList("强效|SV2A 结合（痫样放电抑制）;中效|AMPA 通路增强"),
    enzymes = emptyList(),
    inhibitions = emptyList(),
    pk = cons(PkProfile(
        route = "口服", form = "常释", halfLife = 7, tmax = "",
        clearance = "一级（肝代谢）", curve = "对数", bio = 1.0,
        metabolites = emptyList(),
        activeForms = emptyList()
    ), emptyList()),
    acuteTher = emptyList(),
    chronicTher = ratedList("弱效|认知增强"),
    acuteAdv = ratedList("常见|嗜睡;少见|易怒"),
    chronicAdv = ratedList("少见|行为异常（攻击性）"),
    withdraw = emptyList(),
    overdose = ratedList(">1000mg单次|过量风险"),
    admin = "口服"
