// app/warn.subl —— 预警引擎（纯函数）
//
// 规格见 docs/语法糖手册.md §预警：
//   呼吸抑制风险 —— 阿片与苯二氮卓类各自的呼吸抑制**权重**，跨类叠加：
//     阿片（μ 激动剂）为剂量依赖性呼吸抑制的主驱动（权重高）；
//     BZD 单用呼吸抑制少见（权重低）、与阿片联用显著协同放大（教科书级事实）。
//     类内取最大、跨类相加，阈值沿用规格：提示 3 / 警告 5 / 危险 7。
//     **单类单药永不过危险阈**（类内最大 5），两类同服方可叠加至 7+ → 红色危险。
//   代谢相互作用 —— 联用药品「CYP 酶抑制交集」的抑制权重合计。
//     权重：弱效 1 / 中效 2 / 强效 3 / 极强 5；阈值：提示 1 / 警告 3 / 危险 5
//
// 语义约定（对规格的两点落地，注释存档）：
//   1. 「呼吸抑制」按受控词表计频率权重（罕见 1 / 少见 2 / 常见 3 / 十分常见 5，
//      词表外 0）；呼吸抑制为统一词条（括注变体已合并、跨药聚合不稀释）。
//      不计入单药权重（避免循环归因）；
//   2. 「酶抑制交集」按药品数计：某酶被 >= 2 个联用药品关联（抑制或经代谢）
//      才触发，权重只计抑制剂（经代谢本身不贡献权重——受控词表无对应权重）。

// 预警等级：0 无 / 1 提示 / 2 警告 / 3 危险。
struct Trigger(name: Str, score: Nat)
struct Alert(level: Nat, items: List[Trigger])

// 预警等级名（UI 用）。
fun levelName(level: Nat): Str = when (level) {
    1 => "提示"
    2 => "警告"
    3 => "危险"
    else => "无"
}

// ---------- 权重表与阈值（规格固定值） ----------

// 不良反应频率权重：罕见 1 / 少见 2 / 常见 3 / 十分常见 5（词表外 0）。
fun adrWeight(level: Str): Nat = when (level) {
    "罕见" => 1
    "少见" => 2
    "常见" => 3
    "十分常见" => 5
    else => 0
}

// 酶抑制权重：弱效 1 / 中效 2 / 强效 3 / 极强 5（词表外 0）。
fun inhibWeight(level: Str): Nat = when (level) {
    "弱效" => 1
    "中效" => 2
    "强效" => 3
    "极强" => 5
    else => 0
}

// 不良反应预警阈值：提示 3 / 警告 5 / 危险 7。
fun advLevel(score: Nat): Nat = if (score >= 7) 3 else if (score >= 5) 2 else if (score >= 3) 1 else 0

// 代谢相互作用阈值：提示 1 / 警告 3 / 危险 5。
fun metabLevel(score: Nat): Nat = if (score >= 5) 3 else if (score >= 3) 2 else if (score >= 1) 1 else 0

// ---------- 不良反应预警 ----------

// 条目计分表：名称 -> (权重合计, 条目数)。
struct Score(name: Str, total: Nat, count: Nat)

// ---------- 呼吸抑制风险（联用叠加模型） ----------

// 分类：tags 含「阿片」→ 阿片类；含「苯二氮卓」→ 苯二氮卓类（其余类不计入呼吸抑制叠加）。
fun tagHas(s: Str, key: Str): Bool = when (strIndexOf(s, key)) {
    is Some(_) => true
    None => false
}
fun classTagged(d: Drug, key: Str): Bool = d.tags.fold(false) { acc, s => if (tagHas(s, key)) true else acc }

// 「呼吸抑制」精确条目（急性或慢性）的频率权重最高值（受控词表外条目 0）。
fun respBaseWeight(xs: List[Rated]): Nat = when (xs) {
    Nil => 0
    is Cons(r, rest) => if (r.name == "呼吸抑制")
        respMax(adrWeight(r.level), respBaseWeight(rest))
    else respBaseWeight(rest)
    else => 0
}
fun respMax(a: Nat, b: Nat): Nat = if (a > b) a else b

// 过量段含「呼吸抑制」条目：剂量依赖性呼吸抑制的文献证据（固定证据分 2）。
fun hasOverdoseResp(xs: List[Rated]): Bool = when (xs) {
    Nil => false
    is Cons(r, rest) => if (tagHas(r.name, "呼吸抑制")) true else hasOverdoseResp(rest)
    else => false
}

// 单药呼吸抑制权重 = 频率词表权重（类内最高）+ 过量证据分。
// 参考值：吗啡等强阿片 常见3 + 证据2 = 5；可待因/曲马多 少见2 + 证据2 = 4；BZD 少见2 + 证据2 = 4。
fun respWeightOf(d: Drug): Nat =
    respBaseWeight(append(d.acuteAdv, d.chronicAdv)) + (if (hasOverdoseResp(d.overdose)) 2 else 0)

// 类内最大权重（同类多药不重复累加——同类叠加不触发危险，避免多药 BZD 误报红色）。
fun classMaxWeight(drugs: List[Drug], key: Str): Nat = when (drugs) {
    Nil => 0
    is Cons(d, rest) => if (classTagged(d, key))
        respMax(respWeightOf(d), classMaxWeight(rest, key))
    else classMaxWeight(rest, key)
    else => 0
}

// 呼吸抑制风险预警：分 = 阿片类最大权重 + BZD 类最大权重；等级沿用规格阈值 3/5/7。
// 单类单药（如仅吗啡 5）达不到 7 → 至多「警告」（剂量依赖提示），绝非红色危险；
// 两类同服（5 + 4 >= 9）→ 危险，UI 红底闪烁（overdose 通路）。
fun respAlert(drugs: List[Drug]): Alert {
    var score: Nat = classMaxWeight(drugs, "阿片") + classMaxWeight(drugs, "苯二氮卓")
    var lv: Nat = advLevel(score)
    var ts: List[Trigger] = if (lv >= 3) cons(Trigger("呼吸抑制（联用叠加）", score), emptyList())
        else if (lv >= 2) cons(Trigger("呼吸抑制（剂量依赖）", score), emptyList())
        else emptyList()
    return Alert(lv, ts)
}

// ---------- 权重 → 呈现色（白 → 黄 → 红 连续渐变） ----------
//
// 与 UI 呈现层的唯一契约：宿主（DshComposeHost.kt warnColor/warnFg）与 JS 运行时
// 按本表复制同一映射，驱动 chip 底色/字色/闪烁（权重 0 不渲染）。
// 阈值说明（与规格 3/5/7 对齐）：
//   权重 1-2 → 极浅黄白（#FFFDE7 系）；3-4 → 黄（#FFEE58 系）；5-6 → 橙（#FFA726 系）；≥7 → 红（#E53935 系）
// 段内 RGB 整数线性插值（48 子步），权重 ≥9 截断到 9 → 红色饱和不再变深；
// ≥9 另触发 flash（明显危险：真实阿片+BZD 叠加 5+4；单类最高 5 不触发）。

// 截断除法（ Nat）：subl 的 / 编译为 JS 浮点除，用 (x - x%d)/d 得到与宿主
// Kotlin Int 除法一致的正数截断；注意 subl 算符一律左结合，因子必须显式括起。
fun quot(x: Nat, d: Nat): Nat = (x - (x % d)) / d

// 整数线性插值（差值始终非负 → 截断一致）。
fun respLerp(a: Nat, b: Nat, num: Nat, den: Nat): Nat =
    if (a >= b) a - quot((a - b) * num, den) else a + quot((b - a) * num, den)

// 自然数 → 单个十六进制字符（小写值域 0..15）。
fun hexDigit(n: Nat): Str = if (n == 0) "0" else if (n == 1) "1" else if (n == 2) "2" else if (n == 3) "3"
    else if (n == 4) "4" else if (n == 5) "5" else if (n == 6) "6" else if (n == 7) "7"
    else if (n == 8) "8" else if (n == 9) "9" else if (n == 10) "A" else if (n == 11) "B"
    else if (n == 12) "C" else if (n == 13) "D" else if (n == 14) "E" else "F"

// 0..255 → 两位十六进制（不足补零）。
fun hexByte(n: Nat): Str = concat(hexDigit(quot(n, 16)), hexDigit(n % 16))

// 权重 → chip 底色（#F5 前缀 = 96% 不透明度，近似实色但兼容卡片叠加）。
// 通道：R 255 固定至 6 段后插值到 229；G/B 三段折线（浅 → 黄 → 橙 → 红）。
fun respR(s: Nat): Nat = if (s <= 6) 255 else respLerp(255, 229, (s - 6) * 16, 48)
fun respG(s: Nat): Nat = if (s <= 4) respLerp(253, 238, (s - 1) * 16, 48)
    else if (s <= 6) respLerp(238, 167, (s - 4) * 24, 48)
    else respLerp(167, 57, (s - 6) * 16, 48)
fun respB(s: Nat): Nat = if (s <= 4) respLerp(231, 88, (s - 1) * 16, 48)
    else if (s <= 6) respLerp(88, 38, (s - 4) * 24, 48)
    else respLerp(38, 53, (s - 6) * 16, 48)

// 夹紧到 1..9 后给出底色（权重 0 由 UI 侧不渲染，本函数仍夹到浅端）。
fun respColor(score: Nat): Str {
    var s: Nat = if (score > 9) 9 else if (score < 1) 1 else score
    return concat("#F5", concat(hexByte(respR(s)), concat(hexByte(respG(s)), hexByte(respB(s)))))
}

// 权重 → 字色：红底（>=7）用白字保证对比度，其余暖底用深棕 #4E342E。
fun respTextColor(score: Nat): Str = if (score >= 7) "#FFFFFF" else "#4E342E"

// ---------- 主观效应词条流（effectTags：联用药品急性/慢性不良反应聚合） ----------
//
// 用户模型（t71 rev2）：预警区 = 一堆主观效应词条 chip，白/黄/红三级（越深越重），
// 急性词条 flash、慢性不闪，综合征包（血清素综合征/阿片类中毒）独立样式。
// 来源 = 各药 acuteAdv/chronicAdv（频率词表）；跨药同名聚合：每多一个药物来源 +1 级（上限 3）。
// 「血清素综合征」本身即数据词条（多药罕见 ×N），聚合到红即综合征包效果；
// 「阿片类中毒」由引擎按联用结构（阿片类 ∩ 苯二氮卓）直接给出。

// 词条（呈现层契约：name 短文字 / level 1-3 / acute 是否闪烁 / pack 综合征包标记）。
struct EffTag(name: Str, level: Nat, acute: Bool, pack: Bool)

// 聚合前条目：名 / 药品下标 / 基准级 / 是否急性来源。
struct EffEnt(name: Str, drug: Nat, base: Nat, acute: Bool)

// 频率词 → 基准级（复用 main.subl advFreqLevel：十分常见 3 / 常见 2 / 少见 1；词表外 0 引擎兜 1）。
fun effFreqBase(freq: Str): Nat = if (advFreqLevel(freq) == 0) 1 else advFreqLevel(freq)

// 主观效应判定（t73 清洗）：词条池只留作用于主观体验/感受/意识的效应；
// 客观体征/生理指标/行为后果/长期状态（依赖、耐受、跌倒、便秘、口干、尿潴留、出汗、
// 瘙痒、瞳孔改变、血压下降/低血压、QT/心律、低血钠、性功能障碍、免疫抑制、肌阵挛、
// 低血糖、皮疹、过敏、腹泻、癫痫、胸壁强直、去甲哌替啶神经毒性）一律剔除。
// 呼吸抑制非纯主观但用户明令保留（核心预警价值，◆阿片类中毒包依赖它）。
fun effNonSubjectiveRoots(): List[Str] = strList("依赖,耐受,跌倒,便秘,口干,尿潴留,出汗,瘙痒,瞳孔,血压下降,低血压,QT间期,心律失常,低血钠,性功能,免疫抑制,肌阵挛,低血糖,皮疹,过敏反应,腹泻,癫痫,胸壁强直,去甲哌替啶,流泪流涕,肌痛,肌肉痛,哈欠,寒战")
fun isSubjective(name: Str): Bool = noRootOf(name, effNonSubjectiveRoots())
fun noRootOf(name: Str, roots: List[Str]): Bool = when (roots) {
    is Cons(h, rest) => if (tagHas(name, h)) false else noRootOf(name, rest)
    else => true
}

// 单药全部词条（急性 + 慢性，仅主观效应），带药品下标供跨药去重计数。
fun effEntries(d: Drug, idx: Nat): List[EffEnt] = append(
    map(filter(d.acuteAdv) { r => isSubjective(r.name) }) { r => EffEnt(r.name, idx, effFreqBase(r.level), true) },
    map(filter(d.chronicAdv) { r => isSubjective(r.name) }) { r => EffEnt(r.name, idx, effFreqBase(r.level), false) }
)

// 联用集全部词条（按下标尾递归展开）。
fun effAll(drugs: List[Drug]): List[EffEnt] = effAllAt(drugs, 0)
fun effAllAt(drugs: List[Drug], idx: Nat): List[EffEnt] = when (drugs) {
    is Cons(d, rest) => append(effEntries(d, idx), effAllAt(rest, idx + 1))
    else => emptyList()
}

// 词条名并集；同名条目；最高基准级；含急性来源；药物来源数（下标去重）。
fun effNames(es: List[EffEnt]): List[Str] = distinct(map(es) { e => e.name })
fun effOfName(es: List[EffEnt], n: Str): List[EffEnt] = filter(es) { e => e.name == n }
fun effMaxBase(es: List[EffEnt]): Nat = es.fold(0) { acc, e => if (e.base > acc) e.base else acc }
fun effAnyAcute(es: List[EffEnt]): Bool = es.fold(false) { acc, e => if (e.acute) true else acc }
fun effDrugCount(es: List[EffEnt]): Nat = size(distinct(map(es) { e => e.drug }))

// 聚合级 = 基准 + 来源数 - 1，封顶 3（单药十分常见即红；两药常见叠加亦红）。
fun effLevel(base: Nat, drugs: Nat): Nat = if (base + drugs >= 4) 3 else base + drugs - 1

// 综合征包名表。
// 包判定：综合征类词条（血清素综合征/阿片戒断综合征/停药综合征…）与引擎「阿片类中毒」。
fun effIsPack(n: Str): Bool = if (tagHas(n, "综合征")) true else n == "阿片类中毒"

// 一条聚合后的词条。
fun effTagOf(es: List[EffEnt], n: Str): EffTag {
    var ms: List[EffEnt] = effOfName(es, n)
    var base: Nat = effMaxBase(ms)
    var drugs: Nat = effDrugCount(ms)
    return EffTag(n, effLevel(base, drugs), effAnyAcute(ms), effIsPack(n))
}

// 阿片类 + 苯二氮卓联用 → 阿片类中毒包（危险、急性、包样式；单类不触发）。
fun anyTagged(drugs: List[Drug], key: Str): Bool = drugs.fold(false) { acc, d => if (classTagged(d, key)) true else acc }
fun effPoisoningPack(drugs: List[Drug]): List[EffTag] =
    if (anyTagged(drugs, "阿片") && anyTagged(drugs, "苯二氮卓")) cons(EffTag("阿片类中毒", 3, true, true), emptyList())
    else emptyList()

// 排序键：级降序 → 急性优先 → 包优先（红 > 黄 > 白，同级急性先、包先）。
fun effBefore(a: EffTag, b: EffTag): Bool = if (a.level > b.level) true
    else if (a.level < b.level) false
    else if (a.acute && !b.acute) true
    else if (!a.acute && b.acute) false
    else a.pack && !b.pack

// 插入排序（纯函数、结构递减）。
fun effInsert(xs: List[EffTag], t: EffTag): List[EffTag] = when (xs) {
    is Cons(h, rest) => if (effBefore(t, h)) cons(t, xs) else cons(h, effInsert(rest, t))
    else => cons(t, emptyList())
}
fun effSortTags(xs: List[EffTag]): List[EffTag] = when (xs) {
    is Cons(h, rest) => effInsert(effSortTags(rest), h)
    else => emptyList()
}

// ---------- 维持浓度骤降 → 戒断预警（t74 §2，纯函数） ----------
//
// 用户模型：「长期维持在某血药浓度的药突然跌下去 → 加该药戒断反应词条」。
// 判定 = 长期维持（48h 窗口内 ≥3 次规律给药，形成维持带）+ 骤降（当前浓度跌破峰值 30%）。
// 漏服保护：距末次给药不足 2 个给药间隔视为漏服单次（浓度可能跌破但会随下一剂恢复），不触发。
// 浓度复用 pk.subl concentrationAt（一室一级消除，与图表同公式）。
fun withdrawCrashed(doses: List[Dose], tHalf: Rat, tAbs: Rat, bio: Rat, now: Rat): Bool {
    var recent: List[Dose] = filter(doses) { d => (now >= toRat(d.time)) && ((now - toRat(d.time)) <= 48.0) }
    var last: Nat = recent.fold(0) { acc, d => if (d.time > acc) d.time else acc }
    var first: Nat = recent.fold(999999) { acc, d => if (d.time < acc) d.time else acc }
    var interval: Nat = (last - first) / (size(recent) - 1)
    var grace: Rat = toRat(interval + interval)
    // 峰值取各剂峰时近似采样（服药时刻 + T_a ≈ 峰时；累积曲线峰位略后，偏保守判定）。
    var peak: Rat = recent.fold(0.0) { acc, d =>
        var c: Rat = concentrationAt(doses, tHalf, tAbs, bio, toRat(d.time) + tAbs)
        if (c > acc) c else acc }
    var cur: Rat = concentrationAt(doses, tHalf, tAbs, bio, now)
    return if (size(recent) < 3) false
    else if (interval < 1) false
    else if ((now - toRat(last)) < grace) false
    else if (peak <= 0.0) false
    else cur <= (peak * 0.3)
}

// 一药是否处于骤降戒断（按其台账剂量序列与药代参数在 now 时刻判定）。
fun withdrawDrugOf(d: Drug, doses: List[Dose], now: Rat): Bool {
    var h: Rat = toRat(halfNat(d.pk))
    var a: Rat = absorbHalf(tmaxHours(tmaxOf(d.pk)), h)
    var b: Rat = bioRat(d.pk)
    return withdrawCrashed(doses, h, a, b, now)
}
fun tmaxOf(pk: List[PkProfile]): Str = when (pk) {
    is Cons(p, _) => p.tmax
    else => "-"
}

// 戒断词条：该药 withdraw 段的主观项（急性来源 → flash），综合征（如「阿片戒断综合征」）
// 走 ◆ 包格式；级别按频率词映射（阿片戒断综合征十分常见 → 红 3）。
fun withdrawTagsOf(d: Drug): List[EffTag] =
    map(filter(d.withdraw) { r => isSubjective(r.name) }) { r => EffTag(r.name, advFreqLevel(r.level), true, effIsPack(r.name)) }

// 预警区呈现契约：词条流（排序后）+ 骤降戒断词条（withdrawn = 已判定骤降的药）。
// 与宿主 DshComposeHost.effectTags() 同表同规则（宿主侧下版同步）。
fun effectTags(drugs: List[Drug], withdrawn: List[Drug]): List[EffTag] {
    var es: List[EffEnt] = effAll(drugs)
    var adv: List[EffTag] = append(map(effNames(es)) { n => effTagOf(es, n) }, effPoisoningPack(drugs))
    var wd: List[EffTag] = withdrawn.fold(emptyList()) { acc, d => append(acc, withdrawTagsOf(d)) }
    return effSortTags(append(adv, wd))
}

// ---------- 代谢相互作用预警 ----------

// 全部出现的酶名并集（来自各药抑制清单与经代谢酶集）。
fun allEnzymes(drugs: List[Drug]): List[Str] =
    distinct(joinEnzymeLists(map(drugs) { d => append(inhibNames(d.inhibitions), d.enzymes) }))

fun inhibNames(xs: List[Rated]): List[Str] = map(xs) { r => r.name }

// 字符串列表的列表拼接。
fun joinEnzymeLists(xss: List[List[Str]]): List[Str] = xss.fold(emptyList()) { acc, ys => append(acc, ys) }

// 与酶 e 关联（抑制或经代谢）的联用药品数。
fun relatedCount(drugs: List[Drug], e: Str): Nat =
    drugs.fold(0) { acc, d => if (relatesTo(d, e)) acc + 1 else acc }

// 药品 d 与酶 e 关联：e 在 d 的抑制清单或经代谢酶集中。
fun relatesTo(d: Drug, e: Str): Bool =
    if (contains(d.enzymes, e)) true else containsRated(d.inhibitions, e)

fun containsRated(xs: List[Rated], e: Str): Bool = xs.fold(false) { acc, r => if (r.name == e) true else acc }

// 联用药品对酶 e 的抑制权重合计（仅抑制剂贡献）。
fun inhibTotal(drugs: List[Drug], e: Str): Nat =
    drugs.fold(0) { acc, d => acc + inhibWeightOf(d.inhibitions, e) }

fun inhibWeightOf(xs: List[Rated], e: Str): Nat =
    xs.fold(0) { acc, r => if (r.name == e) acc + inhibWeight(r.level) else acc }

// 代谢相互作用预警：触发项 = 被 >= 2 个药品关联且抑制权重 > 0 的酶；等级 = 各触发项等级之最高者。
fun metabAlert(drugs: List[Drug]): Alert {
    var ts: List[Trigger] = metabTriggers(drugs)
    return Alert(maxLevelMetab(ts), ts)
}

fun metabTriggers(drugs: List[Drug]): List[Trigger] =
    map(filter(metabScores(drugs)) { s => if (s.count >= 2) s.total > 0 else false }) { s => Trigger(s.name, s.total) }

fun metabScores(drugs: List[Drug]): List[Score] =
    map(allEnzymes(drugs)) { e => Score(e, inhibTotal(drugs, e), relatedCount(drugs, e)) }

fun maxLevelMetab(ts: List[Trigger]): Nat =
    ts.fold(0) { acc, t => if (metabLevel(t.score) > acc) metabLevel(t.score) else acc }

// ---------- 综合输出 ----------

// 两侧预警的总体最高等级（首页预警栏用）。
fun maxAlertLevel(a: Alert, b: Alert): Nat = if (b.level > a.level) b.level else a.level
