// app/warn.subl —— 预警引擎（纯函数）
//
// 规格见 docs/语法糖手册.md §预警：
//   呼吸抑制风险 —— 阿片与苯二氮卓类各自的呼吸抑制**权重**，跨类叠加：
//     阿片（μ 激动剂）为剂量依赖性呼吸抑制的主驱动（权重高）；
//     BZD 单用呼吸抑制少见（权重低）、与阿片联用显著协同放大（教科书级事实）。
//     类内取最大、跨类相加，阈值沿用规格：提示 3 / 警告 5 / 危险 7。
//     **单类单药永不过危险阈**（类内最大 5），两类同服方可叠加至 7+ → 红色危险。
//   代谢相互作用 —— 联用药品「CYP 酶抑制交集」的抑制权重合计。
//     权重：弱效 1 / 中效 2 / 强效 3 / 极强 5；阈值：提示 1 / 警告 3 / 危险 5
//
// 语义约定（对规格的两点落地，注释存档）：
//   1. 「呼吸抑制」按受控词表计频率权重（罕见 1 / 少见 2 / 常见 3 / 十分常见 5，
//      词表外 0）；呼吸抑制为统一词条（括注变体已合并、跨药聚合不稀释）。
//      不计入单药权重（避免循环归因）；
//   2. 「酶抑制交集」按药品数计：某酶被 >= 2 个联用药品关联（抑制或经代谢）
//      才触发，权重只计抑制剂（经代谢本身不贡献权重——受控词表无对应权重）。

// 预警等级：0 无 / 1 提示 / 2 警告 / 3 危险。
struct Trigger(name: Str, score: Nat)
struct Alert(level: Nat, items: List[Trigger])

// 预警等级名（UI 用）。
fun levelName(level: Nat): Str = when (level) {
    1 => "提示"
    2 => "警告"
    3 => "危险"
    else => "无"
}

// ---------- 权重表与阈值（规格固定值） ----------

// 不良反应频率权重：罕见 1 / 少见 2 / 常见 3 / 十分常见 5（词表外 0）。
fun adrWeight(level: Str): Nat = when (level) {
    "罕见" => 1
    "少见" => 2
    "常见" => 3
    "十分常见" => 5
    else => 0
}

// 酶抑制权重：弱效 1 / 中效 2 / 强效 3 / 极强 5（词表外 0）。
fun inhibWeight(level: Str): Nat = when (level) {
    "弱效" => 1
    "中效" => 2
    "强效" => 3
    "极强" => 5
    else => 0
}

// 不良反应预警阈值：提示 3 / 警告 5 / 危险 7。
fun advLevel(score: Nat): Nat = if (score >= 7) 3 else if (score >= 5) 2 else if (score >= 3) 1 else 0

// 代谢相互作用阈值：提示 1 / 警告 3 / 危险 5。
fun metabLevel(score: Nat): Nat = if (score >= 5) 3 else if (score >= 3) 2 else if (score >= 1) 1 else 0

// ---------- t79 rev2：剂量量效模型（正/副作用权重随剂量提升） ----------
//
// 常用口服剂量（mg；未收录 0）。剂量 / 常用量 < 1.5 → 权重 +0；< 4 → +1；>= 4 → +2。
// 与 DshComposeHost.typDoseOf 同表（宿主下版同步）。
fun typDoseOf(n: Str): Rat = if (n == "氟伏沙明") 100.0
    else if (n == "帕罗西汀") 20.0
    else if (n == "氟西汀") 20.0
    else if (n == "舍曲林") 50.0
    else if (n == "西酞普兰") 20.0
    else if (n == "艾司西酞普兰") 10.0
    else if (n == "地西泮") 5.0
    else if (n == "艾司唑仑") 1.0
    else if (n == "阿普唑仑") 0.4
    else if (n == "氯硝西泮") 0.5
    else if (n == "劳拉西泮") 1.0
    else if (n == "咪达唑仑") 15.0
    else if (n == "吗啡") 10.0
    else if (n == "羟考酮") 10.0
    else if (n == "芬太尼") 0.1
    else if (n == "可待因") 30.0
    else if (n == "曲马多") 50.0
    else if (n == "哌替啶") 50.0
    else if (n == "碳酸锂") 400.0
    else if (n == "丙戊酸") 500.0
    else if (n == "卡马西平") 200.0
    else if (n == "拉莫三嗪") 100.0
    else if (n == "文拉法辛") 75.0
    else if (n == "度洛西汀") 30.0
    else if (n == "阿米替林") 50.0
    else if (n == "米氮平") 30.0
    else if (n == "安非他酮") 150.0
    else if (n == "曲唑酮") 50.0
    else if (n == "氯米帕明") 50.0
    else if (n == "哌甲酯") 10.0
    else if (n == "阿托莫西汀") 40.0
    else if (n == "多奈哌齐") 5.0
    else if (n == "卡巴拉汀") 3.0
    else if (n == "加兰他敏") 8.0
    else if (n == "丁螺环酮") 15.0
    else if (n == "苏沃瑞生") 10.0
    else if (n == "莱博瑞生") 5.0
    else if (n == "氯胺酮") 50.0
    else if (n == "裸盖菇素") 10.0
    else if (n == "苯海索") 2.0
    else if (n == "苯扎托品") 1.0
    else if (n == "普拉克索") 0.5
    else if (n == "金刚烷胺") 100.0
    else if (n == "美金刚") 10.0
    else if (n == "普瑞巴林") 75.0
    else if (n == "雷美替胺") 8.0
    else if (n == "奥氮平") 10.0
    else if (n == "喹硫平") 100.0
    else if (n == "布洛芬") 400.0
    else if (n == "塞来昔布") 200.0
    else if (n == "对乙酰氨基酚") 500.0
    else if (n == "咖啡因") 100.0
    else if (n == "乙醇") 14000.0
    else if (n == "尼古丁") 1.0
    else if (n == "环丙沙星") 500.0
    else if (n == "克拉霉素") 250.0
    else if (n == "利福平") 600.0
    else if (n == "口服避孕药（炔雌醇/去氧孕烯）") 1.0
    else if (n == "纳洛酮") 0.4
    else if (n == "氟马西尼") 0.2
    else if (n == "毒扁豆碱") 1.0
    else if (n == "赛庚啶") 4.0
    else 0.0
fun doseBonusAt(dose: Rat, typ: Rat): Nat = if (typ <= 0.0) 0 else if (dose >= (typ * 4.0)) 2 else if (dose >= (typ * 1.5)) 1 else 0
fun doseBonusOf(dose: Rat, name: Str): Nat = doseBonusAt(dose, typDoseOf(name))
fun doseHead(doses: List[Rat]): Rat = when (doses) { is Cons(z, _) => z; else => 0.0 }
fun doseTail(doses: List[Rat]): List[Rat] = when (doses) { is Cons(_, r2) => r2; else => emptyList() }
fun doseAtOf(drugs: List[Drug], doses: List[Rat], n: Str): Rat = when (drugs) {
    is Cons(d, rest) => if (d.name == n) doseHead(doses) else doseAtOf(rest, doseTail(doses), n)
    else => 0.0
}
fun packDosesAt(ds: List[Drug], drugs: List[Drug], doses: List[Rat]): List[Rat] = when (ds) {
    is Cons(d, rest) => cons(doseAtOf(drugs, doses, d.name), packDosesAt(rest, drugs, doses))
    else => emptyList()
}
fun natSub(a: Nat, b: Nat): Nat = if (a >= b) a - b else 0

// ---------- 不良反应预警 ----------

// 条目计分表：名称 -> (权重合计, 条目数)。
struct Score(name: Str, total: Nat, count: Nat)

// ---------- 呼吸抑制风险（联用叠加模型） ----------

// 分类：tags 含「阿片」→ 阿片类；含「苯二氮卓」→ 苯二氮卓类（其余类不计入呼吸抑制叠加）。
fun tagHas(s: Str, key: Str): Bool = when (strIndexOf(s, key)) {
    is Some(_) => true
    None => false
}
fun classTagged(d: Drug, key: Str): Bool = d.tags.fold(false) { acc, s => if (tagHas(s, key)) true else acc }

// 「呼吸抑制」精确条目（急性或慢性）的频率权重最高值（受控词表外条目 0）。
fun respBaseWeight(xs: List[Rated]): Nat = when (xs) {
    Nil => 0
    is Cons(r, rest) => if (r.name == "呼吸抑制")
        respMax(adrWeight(r.level), respBaseWeight(rest))
    else respBaseWeight(rest)
    else => 0
}
fun respMax(a: Nat, b: Nat): Nat = if (a > b) a else b

// 过量段含「呼吸抑制」条目：剂量依赖性呼吸抑制的文献证据（固定证据分 2）。
fun hasOverdoseResp(xs: List[Rated]): Bool = when (xs) {
    Nil => false
    is Cons(r, rest) => if (tagHas(r.name, "呼吸抑制")) true else hasOverdoseResp(rest)
    else => false
}

// 单药呼吸抑制权重 = 频率词表权重（类内最高）+ 过量证据分。
// 参考值：吗啡等强阿片 常见3 + 证据2 = 5；可待因/曲马多 少见2 + 证据2 = 4；BZD 少见2 + 证据2 = 4。
fun respWeightOf(d: Drug): Nat =
    respBaseWeight(append(d.acuteAdv, d.chronicAdv)) + (if (hasOverdoseResp(d.overdose)) 2 else 0)

// 类内最大权重（同类多药不重复累加——同类叠加不触发危险，避免多药 BZD 误报红色）。
fun classMaxWeight(drugs: List[Drug], key: Str): Nat = when (drugs) {
    Nil => 0
    is Cons(d, rest) => if (classTagged(d, key))
        respMax(respWeightOf(d), classMaxWeight(rest, key))
    else classMaxWeight(rest, key)
    else => 0
}

// 呼吸抑制风险预警：分 = 阿片类最大权重 + BZD 类最大权重；等级沿用规格阈值 3/5/7。
// 单类单药（如仅吗啡 5）达不到 7 → 至多「警告」（剂量依赖提示），绝非红色危险；
// 两类同服（5 + 4 >= 9）→ 危险，UI 红底闪烁（overdose 通路）。
fun respAlert(drugs: List[Drug]): Alert {
    var score: Nat = classMaxWeight(drugs, "阿片") + classMaxWeight(drugs, "苯二氮卓")
    var lv: Nat = advLevel(score)
    var ts: List[Trigger] = if (lv >= 3) cons(Trigger("呼吸抑制（联用叠加）", score), emptyList())
        else if (lv >= 2) cons(Trigger("呼吸抑制（剂量依赖）", score), emptyList())
        else emptyList()
    return Alert(lv, ts)
}

// ---------- 权重 → 呈现色（白 → 黄 → 红 连续渐变） ----------
//
// 与 UI 呈现层的唯一契约：宿主（DshComposeHost.kt warnColor/warnFg）与 JS 运行时
// 按本表复制同一映射，驱动 chip 底色/字色/闪烁（权重 0 不渲染）。
// 阈值说明（与规格 3/5/7 对齐）：
//   权重 1-2 → 极浅黄白（#FFFDE7 系）；3-4 → 黄（#FFEE58 系）；5-6 → 橙（#FFA726 系）；≥7 → 红（#E53935 系）
// 段内 RGB 整数线性插值（48 子步），权重 ≥9 截断到 9 → 红色饱和不再变深；
// ≥9 另触发 flash（明显危险：真实阿片+BZD 叠加 5+4；单类最高 5 不触发）。

// 截断除法（ Nat）：subl 的 / 编译为 JS 浮点除，用 (x - x%d)/d 得到与宿主
// Kotlin Int 除法一致的正数截断；注意 subl 算符一律左结合，因子必须显式括起。
fun quot(x: Nat, d: Nat): Nat = (x - (x % d)) / d

// 整数线性插值（差值始终非负 → 截断一致）。
fun respLerp(a: Nat, b: Nat, num: Nat, den: Nat): Nat =
    if (a >= b) a - quot((a - b) * num, den) else a + quot((b - a) * num, den)

// 自然数 → 单个十六进制字符（小写值域 0..15）。
fun hexDigit(n: Nat): Str = if (n == 0) "0" else if (n == 1) "1" else if (n == 2) "2" else if (n == 3) "3"
    else if (n == 4) "4" else if (n == 5) "5" else if (n == 6) "6" else if (n == 7) "7"
    else if (n == 8) "8" else if (n == 9) "9" else if (n == 10) "A" else if (n == 11) "B"
    else if (n == 12) "C" else if (n == 13) "D" else if (n == 14) "E" else "F"

// 0..255 → 两位十六进制（不足补零）。
fun hexByte(n: Nat): Str = concat(hexDigit(quot(n, 16)), hexDigit(n % 16))

// 权重 → chip 底色（#F5 前缀 = 96% 不透明度，近似实色但兼容卡片叠加）。
// 通道：R 255 固定至 6 段后插值到 229；G/B 三段折线（浅 → 黄 → 橙 → 红）。
fun respR(s: Nat): Nat = if (s <= 6) 255 else respLerp(255, 229, (s - 6) * 16, 48)
fun respG(s: Nat): Nat = if (s <= 4) respLerp(253, 238, (s - 1) * 16, 48)
    else if (s <= 6) respLerp(238, 167, (s - 4) * 24, 48)
    else respLerp(167, 57, (s - 6) * 16, 48)
fun respB(s: Nat): Nat = if (s <= 4) respLerp(231, 88, (s - 1) * 16, 48)
    else if (s <= 6) respLerp(88, 38, (s - 4) * 24, 48)
    else respLerp(38, 53, (s - 6) * 16, 48)

// 夹紧到 1..9 后给出底色（权重 0 由 UI 侧不渲染，本函数仍夹到浅端）。
fun respColor(score: Nat): Str {
    var s: Nat = if (score > 9) 9 else if (score < 1) 1 else score
    return concat("#F5", concat(hexByte(respR(s)), concat(hexByte(respG(s)), hexByte(respB(s)))))
}

// 权重 → 字色：红底（>=7）用白字保证对比度，其余暖底用深棕 #4E342E。
fun respTextColor(score: Nat): Str = if (score >= 7) "#FFFFFF" else "#4E342E"

// ---------- 主观效应词条流（effectTags：联用药品急性/慢性不良反应聚合） ----------
//
// 用户模型（t71 rev2）：预警区 = 一堆主观效应词条 chip，白/黄/红三级（越深越重），
// 急性词条 flash、慢性不闪，综合征包（血清素综合征/阿片类中毒）独立样式。
// 来源 = 各药 acuteAdv/chronicAdv（频率词表）；跨药同名聚合：每多一个药物来源 +1 级（上限 3）。
// 「血清素综合征」本身即数据词条（多药罕见 ×N），聚合到红即综合征包效果；
// 「阿片类中毒」由引擎按联用结构（阿片类 ∩ 苯二氮卓）直接给出。

// 词条（呈现层契约：name 短文字 / level 1-3 / acute 是否闪烁 / pack 综合征包标记）。
struct EffTag(name: Str, level: Nat, acute: Bool, pack: Bool)

// 聚合前条目：名 / 药品下标 / 基准级 / 是否急性来源。
struct EffEnt(name: Str, drug: Nat, base: Nat, acute: Bool)

// 频率词 → 基准级（复用 main.subl advFreqLevel：十分常见 3 / 常见 2 / 少见 1；词表外 0 引擎兜 1）。
fun effFreqBase(freq: Str): Nat = if (advFreqLevel(freq) == 0) 1 else advFreqLevel(freq)

// 主观效应判定（t73 清洗）：词条池只留作用于主观体验/感受/意识的效应；
// 客观体征/生理指标/行为后果/长期状态（依赖、耐受、跌倒、便秘、口干、尿潴留、出汗、
// 瘙痒、瞳孔改变、血压下降/低血压、QT/心律、低血钠、性功能障碍、免疫抑制、肌阵挛、
// 低血糖、皮疹、过敏、腹泻、癫痫、胸壁强直、去甲哌替啶神经毒性）一律剔除。
// 呼吸抑制非纯主观但用户明令保留（核心预警价值，◆阿片类中毒包依赖它）。
fun effNonSubjectiveRoots(): List[Str] = strList("依赖,耐受,跌倒,便秘,口干,尿潴留,出汗,瘙痒,瞳孔,血压下降,低血压,QT间期,心律失常,低血钠,性功能,免疫抑制,肌阵挛,低血糖,皮疹,过敏反应,腹泻,癫痫,胸壁强直,去甲哌替啶,流泪流涕,肌痛,肌肉痛,哈欠,寒战")
fun isSubjective(name: Str): Bool = noRootOf(name, effNonSubjectiveRoots())
fun noRootOf(name: Str, roots: List[Str]): Bool = when (roots) {
    is Cons(h, rest) => if (tagHas(name, h)) false else noRootOf(name, rest)
    else => true
}

// 单药全部词条（急性 + 慢性，仅主观效应），带药品下标供跨药去重计数。
// t78：效应词条短名化（chip 显示用；资料页/数据源仍存完整药理表述）。
// 规则：去括注（（…）/（…) /【…】）、去符号（/ 、 ： :）；个别超长词走改写表。
// 综合征包名（◆）允许长名，不经短化。
fun effShortName(s: Str): Str = if (effIsPack(s)) s else effShortRewrite(effStripSym(effStripParen(s)))
fun effStripParen(s: Str): Str = headOf(headOf(headOf(s, "（"), "("), "【")
fun effStripSym(s: Str): Str = strReplace(strReplace(strReplace(strReplace(s, "/", ""), "、", ""), "：", ""), ":", "")
fun headOf(s: Str, sep: Str): Str = when (strSplit(s, sep)) {
    is Cons(h, rest) => h
    else => s
}
fun effShortRewrite(s: Str): Str =
    if (s == "脑损伤者矛盾攻击性") "矛盾攻击性"
    else if (s == "肾衰竭者蓄积致呼吸抑制延长") "蓄积致呼吸抑制"
    else if (s == "半衰期超长致蓄积与换药洗脱困难") "超长半衰期蓄积"
    else if (s == "骤停高剂量癫痫发作") "骤停癫痫发作"
    else s

fun effEntries(d: Drug, idx: Nat, dose: Rat): List[EffEnt] = append(
    map(filter(d.acuteAdv) { r => isSubjective(r.name) }) { r => EffEnt(effShortName(r.name), idx, effFreqBase(r.level) + doseBonusOf(dose, d.name), true) },
    map(filter(d.chronicAdv) { r => isSubjective(r.name) }) { r => EffEnt(effShortName(r.name), idx, effFreqBase(r.level) + doseBonusOf(dose, d.name), false) }
)

// 联用集全部词条（按下标尾递归展开；doses 与 drugs 同序平行，长度不足兜 0）。
fun effAll(drugs: List[Drug], doses: List[Rat]): List[EffEnt] = effAllAt(drugs, doses, 0)
fun effAllAt(drugs: List[Drug], doses: List[Rat], idx: Nat): List[EffEnt] = when (drugs) {
    is Cons(d, rest) => append(effEntries(d, idx, doseHead(doses)), effAllAt(rest, doseTail(doses), idx + 1))
    else => emptyList()
}

// 词条名并集；同名条目；最高基准级；含急性来源；药物来源数（下标去重）。
fun effNames(es: List[EffEnt]): List[Str] = distinct(map(es) { e => e.name })
fun effOfName(es: List[EffEnt], n: Str): List[EffEnt] = filter(es) { e => e.name == n }
fun effMaxBase(es: List[EffEnt]): Nat = es.fold(0) { acc, e => if (e.base > acc) e.base else acc }
fun effAnyAcute(es: List[EffEnt]): Bool = es.fold(false) { acc, e => if (e.acute) true else acc }
fun effDrugCount(es: List[EffEnt]): Nat = size(distinct(map(es) { e => e.drug }))

// 聚合级 = 基准 + 来源数 - 1，封顶 3（单药十分常见即红；两药常见叠加亦红）。
fun effLevel(base: Nat, drugs: Nat): Nat = if (base + drugs >= 4) 3 else base + drugs - 1

// 综合征包名表。
// 包判定：综合征类词条（血清素综合征/阿片戒断综合征/停药综合征…）与引擎「阿片类中毒」。
fun effIsPack(n: Str): Bool = if (tagHas(n, "综合征")) true else n == "阿片类中毒"

// 一条聚合后的词条。
fun effTagOf(es: List[EffEnt], n: Str): EffTag {
    var ms: List[EffEnt] = effOfName(es, n)
    var base: Nat = effMaxBase(ms)
    var drugs: Nat = effDrugCount(ms)
    return EffTag(n, effLevel(base, drugs), effAnyAcute(ms), effIsPack(n))
}

// 阿片类 + 苯二氮卓联用 → 阿片类中毒包（危险、急性、包样式；单类不触发）。
fun anyTagged(drugs: List[Drug], key: Str): Bool = drugs.fold(false) { acc, d => if (classTagged(d, key)) true else acc }
fun effPoisoningPack(drugs: List[Drug]): List[EffTag] =
    if (anyTagged(drugs, "阿片") && anyTagged(drugs, "苯二氮卓")) cons(EffTag("阿片类中毒", 3, true, true), emptyList())
    else emptyList()

// 排序键：级降序 → 急性优先 → 包优先（红 > 黄 > 白，同级急性先、包先）。
fun effBefore(a: EffTag, b: EffTag): Bool = if (a.level > b.level) true
    else if (a.level < b.level) false
    else if (a.acute && !b.acute) true
    else if (!a.acute && b.acute) false
    else a.pack && !b.pack

// 插入排序（纯函数、结构递减）。
fun effInsert(xs: List[EffTag], t: EffTag): List[EffTag] = when (xs) {
    is Cons(h, rest) => if (effBefore(t, h)) cons(t, xs) else cons(h, effInsert(rest, t))
    else => cons(t, emptyList())
}
fun effSortTags(xs: List[EffTag]): List[EffTag] = when (xs) {
    is Cons(h, rest) => effInsert(effSortTags(rest), h)
    else => emptyList()
}

// ---------- 维持浓度骤降 → 戒断预警（t74 §2，纯函数） ----------
//
// 用户模型：「长期维持在某血药浓度的药突然跌下去 → 加该药戒断反应词条」。
// 判定 = 长期维持（48h 窗口内 ≥3 次规律给药，形成维持带）+ 骤降（当前浓度跌破峰值 30%）。
// 漏服保护：距末次给药不足 2 个给药间隔视为漏服单次（浓度可能跌破但会随下一剂恢复），不触发。
// 浓度复用 pk.subl concentrationAt（一室一级消除，与图表同公式）。
fun withdrawCrashed(doses: List[Dose], tHalf: Rat, tAbs: Rat, bio: Rat, now: Rat): Bool {
    var recent: List[Dose] = filter(doses) { d => (now >= toRat(d.time)) && ((now - toRat(d.time)) <= 48.0) }
    var last: Nat = recent.fold(0) { acc, d => if (d.time > acc) d.time else acc }
    var first: Nat = recent.fold(999999) { acc, d => if (d.time < acc) d.time else acc }
    var interval: Nat = (last - first) / (size(recent) - 1)
    var grace: Rat = toRat(interval + interval)
    // 峰值取各剂峰时近似采样（服药时刻 + T_a ≈ 峰时；累积曲线峰位略后，偏保守判定）。
    var peak: Rat = recent.fold(0.0) { acc, d =>
        var c: Rat = concentrationAt(doses, tHalf, tAbs, bio, toRat(d.time) + tAbs)
        if (c > acc) c else acc }
    var cur: Rat = concentrationAt(doses, tHalf, tAbs, bio, now)
    return if (size(recent) < 3) false
    else if (interval < 1) false
    else if ((now - toRat(last)) < grace) false
    else if (peak <= 0.0) false
    else cur <= (peak * 0.3)
}

// 一药是否处于骤降戒断（按其台账剂量序列与药代参数在 now 时刻判定）。
fun withdrawDrugOf(d: Drug, doses: List[Dose], now: Rat): Bool {
    var h: Rat = toRat(halfNat(d.pk))
    var a: Rat = absorbHalf(tmaxHours(tmaxOf(d.pk)), h)
    var b: Rat = bioRat(d.pk)
    return withdrawCrashed(doses, h, a, b, now)
}
fun tmaxOf(pk: List[PkProfile]): Str = when (pk) {
    is Cons(p, _) => p.tmax
    else => "-"
}

// 戒断词条：该药 withdraw 段的主观项（急性来源 → flash），综合征（如「阿片戒断综合征」）
// 走 ◆ 包格式；级别按频率词映射（阿片戒断综合征十分常见 → 红 3）。
fun withdrawTagsOf(d: Drug): List[EffTag] =
    map(filter(d.withdraw) { r => isSubjective(r.name) }) { r => EffTag(effShortName(r.name), advFreqLevel(r.level), true, effIsPack(r.name)) }

// 预警区呈现契约：词条流（排序后）+ 骤降戒断词条（withdrawn = 已判定骤降的药）。
// 与宿主 DshComposeHost.effectTags() 同表同规则（宿主侧下版同步）。
fun effectTags(drugs: List[Drug], withdrawn: List[Drug], doses: List[Rat]): List[EffTag] {
    var es: List[EffEnt] = effAll(drugs, doses)
    var adv: List[EffTag] = append(map(effNames(es)) { n => effTagOf(es, n) }, effPoisoningPack(drugs))
    var wd: List[EffTag] = withdrawn.fold(emptyList()) { acc, d => append(acc, withdrawTagsOf(d)) }
    return effSortTags(append(adv, wd))
}

// ---------- 画像加权整合（t77：profile.subl 规则注入，与 effectTags 同流排序） ----------
//
// 加权结果并入现有效应词条流（不另起 UI）：profileEffectTags 产出的 EffTag 与
// 联用/戒断词条合并后统一 effSortTags 排序（级降序 → 急性 → ◆），UI 侧复用
// withdrawStream 同款单元格渲染。
fun effectTagsWithProfile(drugs: List[Drug], withdrawn: List[Drug], p: Profile, doses: List[Rat]): List[EffTag] =
    effAbsorbTags(effSortTags(append(append(append(effectTags(drugs, withdrawn, doses), effAnticholinergicPack(drugs, doses, p)), profileEffectTags(p, drugs)), substanceInteractions(drugs))), drugs, doses, p)


// ---------- t78：物质/药对相互作用预警（真实联用药对 → EffTag；与宿主同表） ----------
//
// 建模说明：尼古丁/吸烟条目分开——“吸烟（烟草烟雾）”承载 CYP1A2 诱导（多环芳烃），
// “尼古丁”仅表达受体激动与依赖（尼古丁本身不诱导 CYP1A2，文献均以“吸烟”表述）。
fun nameIn(drugs: List[Drug], n: Str): Bool = drugs.fold(false) { acc, d => if (d.name == n) true else acc }

fun substanceInteractions(drugs: List[Drug]): List[EffTag] = append(append(append(append(append(append(append(append(
    if (nameIn(drugs, "环丙沙星") && nameIn(drugs, "咖啡因")) cons(EffTag("环丙沙星×咖啡因：咖啡因清除下降（CYP1A2 抑制）失眠焦虑风险", 2, false, false), emptyList()) else emptyList(),
    if (anyTagged(drugs, "苯二氮卓") && nameIn(drugs, "克拉霉素")) cons(EffTag("克拉霉素×苯二氮卓类：过度镇静风险（CYP3A4 抑制）", 2, true, false), emptyList()) else emptyList()),
    if (nameIn(drugs, "利福平") && nameIn(drugs, "口服避孕药（炔雌醇/去氧孕烯）")) cons(EffTag("利福平×口服避孕药：避孕失败风险（CYP3A4 强诱导）", 2, false, false), emptyList()) else emptyList()),
    if (anyTagged(drugs, "苯二氮卓") && nameIn(drugs, "乙醇")) cons(EffTag("乙醇×苯二氮卓类：呼吸抑制协同（药效学，禁止配伍）", 3, true, true), emptyList()) else emptyList()),
    if (anyTagged(drugs, "阿片") && nameIn(drugs, "乙醇")) cons(EffTag("乙醇×阿片类：呼吸抑制协同（药效学，禁止配伍）", 3, true, true), emptyList()) else emptyList()),
    if (nameIn(drugs, "吸烟（烟草烟雾）") && nameIn(drugs, "咖啡因")) cons(EffTag("吸烟×咖啡因：咖啡因清除加快（CYP1A2 诱导源于烟雾多环芳烃而非尼古丁）", 1, false, false), emptyList()) else emptyList()),
    if (nameIn(drugs, "吸烟（烟草烟雾）") && anyTagged(drugs, "抗精神病药")) cons(EffTag("吸烟×抗精神病药：CYP1A2 诱导降低血药浓度（源于烟雾而非尼古丁）", 1, false, false), emptyList()) else emptyList()),
    if (nameIn(drugs, "槟榔碱") && anyTagged(drugs, "抗精神病药")) cons(EffTag("槟榔碱×抗精神病药：锥体外系症状加重风险", 2, false, false), emptyList()) else emptyList()),
    if (nameIn(drugs, "利福平") && nameIn(drugs, "喹硫平")) cons(EffTag("利福平×喹硫平：血药浓度显著下降（CYP3A4 强诱导）", 2, false, false), emptyList()) else emptyList())

// ---------- 代谢相互作用预警 ----------

// 全部出现的酶名并集（来自各药抑制清单与经代谢酶集）。
fun allEnzymes(drugs: List[Drug]): List[Str] =
    distinct(joinEnzymeLists(map(drugs) { d => append(inhibNames(d.inhibitions), d.enzymes) }))

fun inhibNames(xs: List[Rated]): List[Str] = map(xs) { r => r.name }

// 字符串列表的列表拼接。
fun joinEnzymeLists(xss: List[List[Str]]): List[Str] = xss.fold(emptyList()) { acc, ys => append(acc, ys) }

// 与酶 e 关联（抑制或经代谢）的联用药品数。
fun relatedCount(drugs: List[Drug], e: Str): Nat =
    drugs.fold(0) { acc, d => if (relatesTo(d, e)) acc + 1 else acc }

// 药品 d 与酶 e 关联：e 在 d 的抑制清单或经代谢酶集中。
fun relatesTo(d: Drug, e: Str): Bool =
    if (contains(d.enzymes, e)) true else containsRated(d.inhibitions, e)

fun containsRated(xs: List[Rated], e: Str): Bool = xs.fold(false) { acc, r => if (r.name == e) true else acc }

// 联用药品对酶 e 的抑制权重合计（仅抑制剂贡献）。
fun inhibTotal(drugs: List[Drug], e: Str): Nat =
    drugs.fold(0) { acc, d => acc + inhibWeightOf(d.inhibitions, e) }

fun inhibWeightOf(xs: List[Rated], e: Str): Nat =
    xs.fold(0) { acc, r => if (r.name == e) acc + inhibWeight(r.level) else acc }

// 代谢相互作用预警：触发项 = 被 >= 2 个药品关联且抑制权重 > 0 的酶；等级 = 各触发项等级之最高者。
fun metabAlert(drugs: List[Drug]): Alert {
    var ts: List[Trigger] = metabTriggers(drugs)
    return Alert(maxLevelMetab(ts), ts)
}

fun metabTriggers(drugs: List[Drug]): List[Trigger] =
    map(filter(metabScores(drugs)) { s => if (s.count >= 2) s.total > 0 else false }) { s => Trigger(s.name, s.total) }

fun metabScores(drugs: List[Drug]): List[Score] =
    map(allEnzymes(drugs)) { e => Score(e, inhibTotal(drugs, e), relatedCount(drugs, e)) }

fun maxLevelMetab(ts: List[Trigger]): Nat =
    ts.fold(0) { acc, t => if (metabLevel(t.score) > acc) metabLevel(t.score) else acc }

// ---------- 综合输出 ----------

// 两侧预警的总体最高等级（首页预警栏用）。
fun maxAlertLevel(a: Alert, b: Alert): Nat = if (b.level > a.level) b.level else a.level


// ---------- t79：效应包详情引擎（◆ 综合征 chip 点击展开；rev2 剂量加成 + 逆转剂 + 成员内聚） ----------
//
// 用户模型：
//   1. ◆ 包 chip 可点击 → 详情（BottomSheet）：当前权重（跨药聚合实际数值，含画像加权、
//      剂量加成与逆转剂减免）；三级分层 权重 3-5 轻度（黄）/ 6-8 中度（橙）/ >=9 重度（红）；
//   2. 包内效应按各自贡献权重降序，每条显示来源（哪些药贡献、各贡献多少）；
//   3. 包存在即 flash（急性包），慢性包不闪，普通词条急性判断不变；
//   4. 剂量量效：剂量/常用量 <1.5× 权重 +0、<4× +1、>=4× +2（正/副作用同表）；
//   5. 逆转剂入台账即降低对应包权重：纳洛酮 -4（阿片类中毒）、毒扁豆碱 -3（抗胆碱能
//      综合征）、赛庚啶 -3（血清素综合征）；氟马西尼使阿片类中毒包中苯二氮卓贡献归零；
//   6. 子效应不分家：包显示时其成员效应只随包出现（不另起 chip）；包至少有一个成员
//      权重 > 0 才显示。
struct PackCat(name: Str, keys: List[Str])
struct PackMember(name: Str, weight: Nat, srcs: Str)
struct PackInfo(name: Str, isAcute: Bool, weight: Nat, tier: Nat, rev: Str, desc: Str, members: List[PackMember])

fun packTierOf(w: Nat): Nat = if (w >= 9) 3 else if (w >= 6) 2 else if (w >= 3) 1 else 0
fun packTierName(t: Nat): Str = if (t == 3) "重度" else if (t == 2) "中度" else "轻度"

// 双向子串命中（「潮红」⊆「皮肤干燥潮红」类反向包含）。
fun kwHitOf(name: Str, kw: Str): Bool = if (tagHas(name, kw)) true else tagHas(kw, name)
fun kwHitsAny(name: Str, keys: List[Str]): Bool = when (keys) {
    is Cons(k, rest) => if (kwHitOf(name, k)) true else kwHitsAny(name, rest)
    else => false
}
// 同一药对某成员（多关键词）的最大基准级（急性+慢性条目），叠加剂量加成。
fun memKeysBase(rs: List[Rated], keys: List[Str], acc: Nat): Nat = when (rs) {
    is Cons(r, rest) => if (kwHitsAny(r.name, keys)) memKeysBase(rest, keys, if (effFreqBase(r.level) > acc) effFreqBase(r.level) else acc) else memKeysBase(rest, keys, acc)
    else => acc
}
fun memBaseOfDose(d: Drug, dose: Rat, keys: List[Str]): Nat = memKeysBase(append(d.acuteAdv, d.chronicAdv), keys, 0) + doseBonusOf(dose, d.name)

// 来源串：仅计贡献 >0 的药，格式「药名 +权重，药名 +权重」。
fun memSrc(srcs: Str, name: Str, b: Nat): Str = if (b == 0) srcs else if (srcs == "") concat(name, concat(" +", toStr(b))) else concat(srcs, concat("，", concat(name, concat(" +", toStr(b)))))
// 成员行：跨药聚合权重 + 来源串（doses 与 ds 同序平行）。
fun memberOfCat(cat: PackCat, drugs: List[Drug], doses: List[Rat]): PackMember = memberOfCatAt(cat, drugs, doses, 0, "")
fun memberOfCatAt(cat: PackCat, drugs: List[Drug], doses: List[Rat], w: Nat, srcs: Str): PackMember = when (drugs) {
    is Cons(d, rest) => memberOfCatStep(cat, d, rest, doseHead(doses), doseTail(doses), w, srcs)
    else => PackMember(cat.name, w, srcs)
}
fun memberOfCatStep(cat: PackCat, d: Drug, rest: List[Drug], dz: Rat, drest: List[Rat], w: Nat, srcs: Str): PackMember {
    var b: Nat = memBaseOfDose(d, dz, cat.keys)
    return memberOfCatAt(cat, rest, drest, w + b, memSrc(srcs, d.name, b))
}
fun memberRowsOf(cats: List[PackCat], drugs: List[Drug], doses: List[Rat], acc: List[PackMember]): List[PackMember] = when (cats) {
    is Cons(c, rest) => memberRowsOf(rest, drugs, doses, append(acc, cons(memberOfCat(c, drugs, doses), emptyList())))
    else => acc
}
fun memberWeightSum(ms: List[PackMember], acc: Nat): Nat = when (ms) {
    is Cons(m, rest) => memberWeightSum(rest, acc + m.weight)
    else => acc
}
fun packMaxMember(ms: List[PackMember], acc: Nat): Nat = when (ms) {
    is Cons(m, rest) => if (m.weight > acc) packMaxMember(rest, m.weight) else packMaxMember(rest, acc)
    else => acc
}
// 包内效应按权重降序（插入排序，纯函数）。
fun memberBefore(a: PackMember, b: PackMember): Bool = a.weight > b.weight
fun memberInsert(xs: List[PackMember], m: PackMember): List[PackMember] = when (xs) {
    is Cons(h2, rest) => if (memberBefore(m, h2)) cons(m, xs) else cons(h2, memberInsert(rest, m))
    else => cons(m, emptyList())
}
fun packSortMembers(xs: List[PackMember]): List[PackMember] = when (xs) {
    is Cons(m, rest) => memberInsert(packSortMembers(rest), m)
    else => emptyList()
}

// 抗胆碱能毒理学八联（经典 anticholinergic toxidrome）。
fun packCatsAntiCh(): List[PackCat] = cons(PackCat("瞳孔散大", strList("瞳孔散大")), cons(PackCat("视物模糊", strList("视物模糊,视力模糊")), cons(PackCat("口干", strList("口干")), cons(PackCat("尿潴留", strList("尿潴留")), cons(PackCat("肠鸣音减少", strList("肠鸣音")), cons(PackCat("心动过速", strList("心动过速,心率加快")), cons(PackCat("皮肤干燥潮红", strList("潮红,皮肤干燥")), cons(PackCat("谵妄", strList("谵妄")), emptyList()))))))))
// 血清素综合征（Sternbach 标准）四联。
fun packCatsSeroton(): List[PackCat] = cons(PackCat("震颤/阵挛", strList("震颤,阵挛,肌阵挛")), cons(PackCat("反射亢进", strList("反射亢进")), cons(PackCat("自主神经不稳", strList("出汗,心动过速,体温升高,发热,心悸")), cons(PackCat("精神状态改变", strList("激越,躁动,精神状态改变,烦躁,焦虑")), emptyList()))))
// 阿片类中毒三联。
fun packCatsOpioid(): List[PackCat] = cons(PackCat("意识抑制", strList("意识抑制,镇静,嗜睡,昏迷,昏睡,意识模糊")), cons(PackCat("呼吸抑制", strList("呼吸抑制")), cons(PackCat("瞳孔缩小", strList("瞳孔缩小,针尖样瞳孔")), emptyList())))

// 画像加权：抗胆碱能负荷（年龄>=65/痴呆/认知障碍 各 +2，ACB 概念）。
fun profCondOn(p: Profile, c: Str): Bool = contains(p.conds, c)
fun profAcBoostAt(cs: List[Str], acc: Nat): Nat = when (cs) {
    is Cons(c, rest) => profAcBoostAt(rest, if (c == "痴呆") acc + 2 else if (c == "认知障碍") acc + 2 else acc)
    else => acc
}
fun profAcBoostOf(p: Profile): Nat = profAcBoostAt(p.conds, 0) + (if (p.age >= 65) 2 else 0)
fun joinStrList(xs: List[Str], sep: Str): Str = when (xs) {
    is Cons(x, rest) => if (x == "") joinStrList(rest, sep) else if (joinStrList(rest, sep) == "") x else concat(x, concat(sep, joinStrList(rest, sep)))
    else => ""
}
fun profAcSrcOf(p: Profile): Str = joinStrList(cons(if (p.age >= 65) "年龄>=65 +2" else "", cons(if (profCondOn(p, "痴呆")) "痴呆 +2" else "", cons(if (profCondOn(p, "认知障碍")) "认知障碍 +2" else "", emptyList()))), "，")
fun acBoostRow(p: Profile): List[PackMember] = if (profAcBoostOf(p) > 0) cons(PackMember("画像加权（抗胆碱能负荷）", profAcBoostOf(p), profAcSrcOf(p)), emptyList()) else emptyList()

fun drugNamesOf(ds: List[Drug]): List[Str] = when (ds) {
    is Cons(d, rest) => cons(d.name, drugNamesOf(rest))
    else => emptyList()
}

// 抗胆碱能综合征包：触发 = 联用含抗胆碱能药；成员为经典八联跨药聚合 + 画像加权行；
// 逆转剂：毒扁豆碱（胆碱酯酶抑制，升乙酰胆碱对抗毒蕈碱阻断）权重 -3。
fun antiCholinergicPack(drugs: List[Drug], doses: List[Rat], p: Profile): PackInfo {
    var ds: List[Drug] = filter(drugs) { d => classTagged(d, "抗胆碱能") }
    var dzs: List[Rat] = packDosesAt(ds, drugs, doses)
    var ms: List[PackMember] = packSortMembers(append(memberRowsOf(packCatsAntiCh(), ds, dzs, emptyList()), acBoostRow(p)))
    var gross: Nat = memberWeightSum(ms, 0)
    var red: Nat = if (nameIn(drugs, "毒扁豆碱")) 3 else 0
    var w: Nat = natSub(gross, red)
    var rev: Str = if (red > 0) "毒扁豆碱 −3" else ""
    return PackInfo("抗胆碱能综合征", true, w, packTierOf(w), rev, antiChPackDesc(), ms)
}
fun antiChPackDesc(): Str = "抗胆碱能综合征（anticholinergic toxidrome）：抗胆碱能药过量或联用使毒蕈碱受体过度阻断。经典记忆口诀「干如骨头、红如甜菜、盲如蝙蝠、热如野兔、疯如帽匠」——瞳孔散大、视物模糊、口干、尿潴留、肠鸣音减少、心动过速、皮肤干燥潮红、谵妄。治疗以停药与支持为主，重度可考虑毒扁豆碱。"

// 血清素综合征包：联用血清素能药 >=2 加重（+2/附加药），成员按 Sternbach 四联聚合；
// 逆转剂：赛庚啶（5-HT2 拮抗）权重 -3。
fun serotonergicPack(drugs: List[Drug], doses: List[Rat], p: Profile): PackInfo {
    var ds: List[Drug] = filter(drugs) { d => classTagged(d, "血清素能") }
    var dzs: List[Rat] = packDosesAt(ds, drugs, doses)
    var combo: List[PackMember] = if (size(ds) >= 2) cons(PackMember("血清素能药物联用", 2 * (size(ds) - 1), joinNames(drugNamesOf(ds))), emptyList()) else emptyList()
    var ms: List[PackMember] = packSortMembers(append(memberRowsOf(packCatsSeroton(), ds, dzs, emptyList()), combo))
    var gross: Nat = memberWeightSum(ms, 0)
    var red: Nat = if (nameIn(drugs, "赛庚啶")) 3 else 0
    var w: Nat = natSub(gross, red)
    var rev: Str = if (red > 0) "赛庚啶 −3" else ""
    return PackInfo("血清素综合征", true, w, packTierOf(w), rev, serotonPackDesc(), ms)
}
fun serotonPackDesc(): Str = "血清素综合征（serotonin syndrome，Sternbach 诊断标准）：血清素能药物过量或联用 24h 内出现——震颤/阵挛（尤其下肢）、反射亢进、自主神经不稳（出汗、心动过速、体温升高）、精神状态改变（激越、躁动）。治疗为停用血清素能药与支持，重度用赛庚啶。"

// 阿片类中毒包：阿片+苯二氮卓（或乙醇）联用协同（+2/附加药），成员按三联聚合；
// 逆转剂：纳洛酮（μ 受体竞争性拮抗）权重 -4；氟马西尼（BZD 位点竞争性拮抗）使
// 苯二氮卓类贡献与 μ 协同归零（竞争性拮抗「谁多谁赢」，教科书级事实）。
fun opioidToxPack(drugs: List[Drug], doses: List[Rat], p: Profile): PackInfo {
    var hasFlu: Bool = nameIn(drugs, "氟马西尼")
    var ds: List[Drug] = append(filter(drugs) { d => classTagged(d, "阿片") }, filter(drugs) { d => if (hasFlu) false else classTagged(d, "苯二氮卓") })
    var dzs: List[Rat] = packDosesAt(ds, drugs, doses)
    var combo: List[PackMember] = if ((hasFlu == false) && (size(ds) >= 2)) cons(PackMember("μ 受体药效学协同", 2 * (size(ds) - 1), joinNames(drugNamesOf(ds))), emptyList()) else emptyList()
    var ms: List[PackMember] = packSortMembers(append(memberRowsOf(packCatsOpioid(), ds, dzs, emptyList()), combo))
    var gross: Nat = memberWeightSum(ms, 0)
    var red: Nat = if (nameIn(drugs, "纳洛酮")) 4 else 0
    var w: Nat = natSub(gross, red)
    var rev: Str = concat(if (red > 0) "纳洛酮 −4" else "", if (hasFlu) "氟马西尼：苯二氮卓贡献归零" else "")
    return PackInfo("阿片类中毒", true, w, packTierOf(w), rev, opioidPackDesc(), ms)
}
fun opioidPackDesc(): Str = "阿片类中毒（opioid toxidrome）三联：意识抑制、呼吸抑制、瞳孔缩小（针尖样瞳孔）。苯二氮卓类/乙醇联用为致死性呼吸抑制协同（FDA 黑框警告）；纳洛酮为 μ 受体竞争性拮抗的特效逆转剂，必要时重复给药。"

// 通用包（药对/画像/戒断/其他综合征词条）：权重 = level ×3 换算（3→9 重度，2→6 中度，1→3 轻度）。
fun genericPackInfo(n: Str, lv: Nat, ac: Bool): PackInfo {
    var w: Nat = lv * 3
    return PackInfo(n, ac, w, packTierOf(w), "", packDescOf(n), cons(PackMember("综合权重（词条级别 ×3 换算）", w, concat("level ", toStr(lv))), emptyList()))
}

// 包说明表（教科书级简述；未列入返回空串）。
fun packDescOf(n: Str): Str = if (n == "乙醇×苯二氮卓类：呼吸抑制协同（药效学，禁止配伍）") "乙醇与苯二氮卓类均增强 GABA-A 受体抑制性传导，联用产生非叠加性呼吸抑制（药效学协同，FDA 黑框警告），过量致死风险显著升高。"
    else if (n == "乙醇×阿片类：呼吸抑制协同（药效学，禁止配伍）") "乙醇与阿片类 μ 受体激动剂联用产生非叠加性呼吸抑制（药效学协同，FDA 黑框警告），过量致死风险显著升高。"
    else if (n == "未成年×抗抑郁药：自杀冲动升级（黑框警告）") "美国 FDA 黑框警告：儿童、青少年与年轻成人开始抗抑郁药治疗的前数周自杀念头与自杀行为风险升高，须密切监测行为异常与自杀意念。"
    else ""

// 包详情分派：三个毒理学综合征走跨药聚合，其余走通用换算。
fun packInfoOf(n: Str, drugs: List[Drug], doses: List[Rat], p: Profile, lv: Nat, ac: Bool): PackInfo =
    if (n == "抗胆碱能综合征") antiCholinergicPack(drugs, doses, p)
    else if (n == "血清素综合征") serotonergicPack(drugs, doses, p)
    else if (n == "阿片类中毒") opioidToxPack(drugs, doses, p)
    else genericPackInfo(n, lv, ac)

// 包是否显示：至少一个成员权重 > 0。
fun packDisplayed(n: Str, drugs: List[Drug], doses: List[Rat], p: Profile, lv: Nat): Bool =
    packMaxMember(packInfoOf(n, drugs, doses, p, lv, true).members, 0) > 0

// 毒理学包的成员关键词并集（供子效应内聚判定）。
fun catKeysAt(cats: List[PackCat], acc: List[Str]): List[Str] = when (cats) {
    is Cons(c, rest) => catKeysAt(rest, append(acc, c.keys))
    else => acc
}
fun toxPackKeys(n: Str): List[Str] = if (n == "抗胆碱能综合征") catKeysAt(packCatsAntiCh(), emptyList())
    else if (n == "血清素综合征") catKeysAt(packCatsSeroton(), emptyList())
    else if (n == "阿片类中毒") catKeysAt(packCatsOpioid(), emptyList())
    else emptyList()

// 子效应内聚：词条若命中任一「已显示包」的成员关键词，则只随包出现，不单独分家。
fun effMemberHiddenAt(name: Str, tags: List[EffTag], drugs: List[Drug], doses: List[Rat], p: Profile): Bool = when (tags) {
    is Cons(t, rest) => if (t.pack && packDisplayed(t.name, drugs, doses, p, t.level) && kwHitsAny(name, toxPackKeys(t.name))) true else effMemberHiddenAt(name, rest, drugs, doses, p)
    else => false
}
fun effKeepTag(t: EffTag, tags: List[EffTag], drugs: List[Drug], doses: List[Rat], p: Profile): Bool =
    if (t.pack) packDisplayed(t.name, drugs, doses, p, t.level) else effMemberHiddenAt(t.name, tags, drugs, doses, p) == false
fun effAbsorbTags(tags: List[EffTag], drugs: List[Drug], doses: List[Rat], p: Profile): List[EffTag] =
    filter(tags) { t => effKeepTag(t, tags, drugs, doses, p) }

// chip 呈现助手：包加「 · 轻度/中度/重度」后缀；包闪烁走急性属性（存在即闪）。
fun packChipTier(tg: EffTag, drugs: List[Drug], doses: List[Rat], prof: Profile): Nat = if (tg.pack) packInfoOf(tg.name, drugs, doses, prof, tg.level, tg.acute).tier else 0
fun packChipText(tg: EffTag, drugs: List[Drug], doses: List[Rat], prof: Profile): Str = if (tg.pack) concat(concat("◆ ", tg.name), concat(" · ", packTierName(packChipTier(tg, drugs, doses, prof)))) else tg.name
fun packChipFlash(tg: EffTag, drugs: List[Drug], prof: Profile): Bool = if (tg.pack) packInfoOf(tg.name, drugs, emptyList(), prof, tg.level, tg.acute).isAcute else tg.acute

// 抗胆碱能综合征 chip 注入（联用含抗胆碱能药且至少一个成员有权重时进词条流）。
fun effAnticholinergicPack(drugs: List[Drug], doses: List[Rat], p: Profile): List[EffTag] =
    if (anyTagged(drugs, "抗胆碱能")) {
        var info: PackInfo = antiCholinergicPack(drugs, doses, p)
        if (info.tier > 0) cons(EffTag("抗胆碱能综合征", info.tier, true, true), emptyList()) else emptyList()
    } else emptyList()
