// app/main.subl —— 语法糖手册主界面（t59：照 Kotlin Compose 参考实现，@view v2 协议重写）
//
// 参考实现（F:\KotlinProject\Sugar Manual，原生 Compose/M3 工程）：
//   ui/HomeScreen.kt         Scaffold + TopAppBar + 折线图 + LazyColumn + ExtendedFAB + 弹层
//   ui/InteractionAlerts.kt  预警标签流 FlowRow（混排、半透明色、闪烁）
//   ui/DoseLogList.kt        服药记录卡（Card 圆角 + 4dp 色条 + weight 行）
//   ui/DoseEntrySheet.kt     ModalBottomSheet 表单（Surface 选药行 + OutlinedTextField + 校验）
//   ui/ConcentrationChart.kt 多序列折线（逐药分量线 + 总线渐变 + 图例 + 徽标）
//
// 视图协议 v2（docs/视图协议v2.md）相对 t52 旧协议的兑付：
//   - Modifier 链 = List[MKind]：width(4).height(20) 一条链多修饰符 → 记录卡 4×20dp 色条精确落地
//     （旧协议「一个视图一个修饰符」，色条高度只能靠文本行高近似）
//   - 颜色：#AARRGGBB 直写参考的半透明值（0x33D32F2F 等，不再和白底预混成实色）+ 主题色名
//   - 回调实例键 __dshCb：动态列表（选药行/记录卡）每行独立槽位，点哪行是哪行
//   - 新组件：Card（圆角+阴影）/ TextButton（顶栏 actions）/ Icon（FAB）/ AlertDialog（设置/文档）
//     / BottomSheet（表单，替代旧协议的页内部块）；Box(wrap→FlowLayout, spacing, arrangement, onClick)
//   - Chart 多序列：series = List[Series]（逐药分量线）+ points 总线；图例/徽标
// 仍有的差距见 docs/与原生版布局对照结论.md。

// ---------- 预警标签三级色（参考 InteractionAlerts.kt：0x33 半透明底 + 同色字） ----------
// 过量反应来源的标签：0x40 底 + #D32F2F 字 + flash 动画（与参考的 flashColors 一致）。

fun tagBg(level: Nat, overdose: Bool): Str = if (overdose) "#40D32F2F" else when (level) {
    3 => "#33D32F2F"
    2 => "#33F9A825"
    1 => "#334CAF50"
    else => "#FFFFFF"
}
fun tagFg(level: Nat, overdose: Bool): Str = if (overdose) "#D32F2F" else when (level) {
    3 => "#C62828"
    2 => "#E65100"
    1 => "#2E7D32"
    else => "#49454E"
}

// ---------- 药物颜色（参考 DrugPalettes：SSRI 血清素能剂金色 #FFC107，缺失回退 #00695C） ----------

fun drugColor(name: Str): Str = if (name == "氟伏沙明") "#FFC107"
    else if (name == "帕罗西汀") "#FFC107"
    else if (name == "舍曲林") "#FFC107"
    else if (name == "氟西汀") "#FFC107"
    else if (name == "西酞普兰") "#FFC107"
    else if (name == "艾司西酞普兰") "#FFC107"
    else if (name == "地西泮") "#1976D2"
    else if (name == "艾司唑仑") "#1976D2"
    else if (name == "阿普唑仑") "#1976D2"
    else if (name == "氯硝西泮") "#1976D2"
    else if (name == "劳拉西泮") "#1976D2"
    else if (name == "咪达唑仑") "#1976D2"
    else if (name == "吗啡") "#795548"
    else if (name == "羟考酮") "#E64A19"
    else if (name == "芬太尼") "#6A1B9A"
    else if (name == "可待因") "#8D6E63"
    else if (name == "曲马多") "#00897B"
    else if (name == "哌替啶") "#AD1457"
    else "#00695C"

// ---------- 演示剂量（空台账回退：home 首启不空图） ----------

fun demoDoses(): List[Dose] = cons(Dose(100.0, 0), cons(Dose(100.0, 24), emptyList()))

// ---------- 示例联用集（引擎评估用） ----------

@impure
fun coadmin(): List[Drug] = append(loadDrugs(), cons(fluvoxamine(), cons(paroxetine(), cons(fluoxetine(), cons(sertraline(), cons(citalopram(), cons(escitalopram(), cons(diazepam(), cons(estazolam(), cons(alprazolam(), cons(clonazepam(), cons(lorazepam(), cons(midazolam(), cons(morphine(), cons(oxycodone(), cons(fentanyl(), cons(codeine(), cons(tramadol(), cons(pethidine(), emptyList())))))))))))))))))))

// 台账联用集（呼吸抑制风险引擎输入：以实际服药药名为准，非全库演示集）。
@impure
fun coadminOf(recs: List[DoseRec]): List[Drug] = coadminNames(recentDrugs(recs), coadmin())
@impure
fun coadminNames(names: List[Str], all: List[Drug]): List[Drug] = when (names) {
    Nil => emptyList()
    is Cons(n, rest) => cons(drugByName(n, all), coadminNames(rest, all))
    else => emptyList()
}

// ---------- 表单/弹层状态（storage KV：layout 重渲染时跨帧保持） ----------

fun formKey(): Str = "sm_form"
fun pickKey(): Str = "sm_pick"
fun doseKey(): Str = "sm_dose"
fun settingsKey(): Str = "sm_set"
fun docKey(): Str = "sm_doc"
fun errKey(): Str = "sm_err"

@impure
fun doseErr(): Str = storageGet(errKey())

@impure
fun setDoseErr(e: Str): Null {
    unchecked storagePut(errKey(), e)
    return null
}

@impure
fun isFormOpen(): Bool = storageGet(formKey()) == "1"
@impure
fun isSettingsOpen(): Bool = storageGet(settingsKey()) == "1"
@impure
fun docName(): Str = storageGet(docKey())
@impure
fun isDocOpen(): Bool = storageGet(docKey()) != ""
@impure
fun isListOpen(): Bool = storageGet(drugListKey()) == "1"
@impure
fun drugListKey(): Str = "sm_dlist"

// 选中下标（未选时存空串：参考 selectedDrug = null 的「未选」语义）。
@impure
fun curPick(): Nat = getOrElse(parseNat(storageGet(pickKey())), 0)
@impure
fun isPickSet(): Bool = when (parseNat(storageGet(pickKey()))) {
    is Some(_) => true
    None => false
}
@impure
fun curDose(): Str = storageGet(doseKey())

@impure
fun setFormOpen(o: Bool): Null {
    unchecked storagePut(formKey(), if (o) "1" else "0")
    return null
}
@impure
fun setPickUnset(): Null {
    unchecked storagePut(pickKey(), "")
    return null
}
@impure
fun setPickAt(n: Nat): Null {
    unchecked storagePut(pickKey(), toStr(n))
    return null
}
@impure
fun setDose(t: Str): Null {
    unchecked storagePut(doseKey(), t)
    return null
}
@impure
fun setSettingsOpen(o: Bool): Null {
    unchecked storagePut(settingsKey(), if (o) "1" else "0")
    return null
}
@impure
fun setDocName(n: Str): Null {
    unchecked storagePut(docKey(), n)
    return null
}
@impure
fun setListOpen(o: Bool): Null {
    unchecked storagePut(drugListKey(), if (o) "1" else "0")
    return null
}
@impure
fun refreshHome(): Null {
    unchecked layout(content)
    return null
}

// ---------- 生命周期 ----------

@impure
fun main(): Null {
    onCreate {
        unchecked log("Sugar Manual 已加载（t59：v2 协议照 Compose 参考重写）", 2)
    }
    onStart {
        layout(content)
    }
}

// ---------- 顶栏（≈ M3 TopAppBar：primaryContainer 底 64dp + 标题行 + actions 右推） ----------

@composable
fun topBar(): Box = Box(modifier = fillWidth().height(48).background("primary"), orientation = "horizontal", arrangement = "SpaceBetween", contentAlignment = CenterStart()) {
    Box(modifier = paddingH(16), orientation = "horizontal", contentAlignment = CenterStart()) {
        Text(text = "语法糖手册", size = 22, bold = true, color = "onPrimary")
        Box(modifier = width(6)) {}
        Text(text = "V1.0", size = 11, color = "onPrimary")
    }
    Box(modifier = paddingH(12), orientation = "horizontal") {
        TextButton(onClick = { unchecked openDrugList() }) {
            Icon(name = "info", size = 22, tint = "onPrimary")
        }
        TextButton(onClick = { unchecked openDrugList() }) {
            Icon(name = "menu", size = 22, tint = "onPrimary")
        }
        TextButton(onClick = { unchecked openSettingsDialog() }) {
            Icon(name = "settings", size = 22, tint = "onPrimary")
        }
    }
}

// 参考顶栏 actions 的「药物」（onOpenDrugs → 药物领域页）：当前协议无多页导航，
// 以 toast 说明（差距清单 §5）。
@impure
fun noNavigation(): Null {
    unchecked toast("药物页：当前视图协议无多页导航", false)
    null
}

// ---------- 呼吸抑制风险标签流（≈ InteractionAlerts：FlowRow，替代原联用不良反应流） ----------

@composable
fun respStream(rs: Alert): Any = if (size(rs.items) == 0) {
    Box(modifier = fillWidth().paddingHV(24, 8)) {
        Text(text = "暂无预警", color = "onSurfaceVariant", size = 14)
    }
} else {
    Box(modifier = fillWidth().paddingHV(24, 8)) {
        // FlowRow：wrap=true → 流式换行；spacing=8 横竖间距（参考的 spacedBy(8.dp)）。
        Box(modifier = fillWidth(), wrap = true, spacing = 8, children = respTagList(rs.items))
    }
}

fun respTagList(items: List[Trigger]): List[Any] = when (items) {
    Nil => emptyList()
    is Cons(t1, rest) => cons(respTagCell(t1), respTagList(rest))
    else => emptyList()
}

// 危险（两类叠加 ≥7）走 overdose 红底 flash 通路（tagBg/tagFg 的 #40 同款）；
// 警告（单类剂量依赖 ≥5）为橙色提示，不出红色。
@composable
fun respTagCell(t1: Trigger): Any {
    var lv: Nat = advLevel(t1.score)
    var od: Bool = lv >= 3
    return Box(modifier = clip(12).background(tagBg(lv, od)).paddingHV(12, 5)) {
        Text(text = concat(t1.name, concat(" · 权重×", toStr(t1.score))), color = tagFg(lv, od), size = 14, bold = true, flash = od)
    }
}

// 标签单元（≈ AlertTag：圆角 12 + 半透明底 + 同色加粗字 + 闪烁）。
// 圆角 = clip(12)（链元素）；半透明 #33AARRGGBB 直写（旧协议需预混实色）。
// CYP450 代谢相互作用预警流（与 ADR 流并列）：触发酶 = 被 >=2 个药品关联且抑制权重 > 0。
@composable
fun metabStream(met: Alert): Any = if (size(met.items) == 0) {
    Box(modifier = fillWidth()) {}
} else {
    Box(modifier = fillWidth().paddingHV(24, 8), orientation = "vertical", spacing = 6) {
        Text(text = "CYP450 代谢相互作用", color = "onSurfaceVariant", size = 12, bold = true)
        Box(modifier = fillWidth(), wrap = true, spacing = 8, children = metabTagList(metabItems(met)))
    }
}
fun metabItems(met: Alert): List[Trigger] = append(metabAt(3, met.items), append(metabAt(2, met.items), metabAt(1, met.items)))
fun metabAt(l: Nat, ts: List[Trigger]): List[Trigger] = filter(ts) { x => metabLevel(x.score) == l }
@composable
fun metabTagList(ts: List[Trigger]): List[Any] = when (ts) {
    Nil => emptyList()
    is Cons(x, rest) => cons(metabTagCell(x), metabTagList(rest))
    else => emptyList()
}
@composable
fun metabTagCell(t: Trigger): Any = Box(modifier = clip(12).background(tagBg(metabLevel(t.score), false)).paddingHV(12, 5)) {
    Text(text = concat(t.name, concat(" 抑制 ×", toStr(t.score))), color = tagFg(metabLevel(t.score), false), size = 14, bold = true)
}
// ---------- 服药记录（≈ DoseLogList：Card + 颜色竖条 + 四字段） ----------

struct MedCard(name: Str, time: Str, route: Str, dose: Str)

fun routeOf(name: Str, drugs: List[Drug]): Str = when (drugs) {
    Nil => "口服"
    is Cons(d, rest) => if (d.name == name) firstRoute(d.pk) else routeOf(name, rest)
}
fun firstRoute(pk: List[PkProfile]): Str = when (pk) {
    is Cons(p, _) => p.route
    Nil => "口服"
}

// 药代数值（图表与副标题共用）。
fun halfNat(pk: List[PkProfile]): Nat = when (pk) {
    is Cons(p, _) => p.halfLife
    Nil => 24
}
fun bioRat(pk: List[PkProfile]): Rat = when (pk) {
    is Cons(p, _) => p.bio
    Nil => 1.0
}
fun detailHalf(pk: List[PkProfile]): Str = toStr(halfNat(pk))
fun detailBio(pk: List[PkProfile]): Str = toStr(bioRat(pk) * 100.0)

// 参考药物行副标题：管理分类 · T½ Xh · F=Y% · 给药途径。
// F≈ 表示该药的生物利用度为区间中值/取整/保守假设（无单点实测），F= 表示有实测或说明书单点值。
fun estDrug(n: Str): Bool = if (n == "氟西汀") true
    else if (n == "地西泮") true
    else if (n == "艾司唑仑") true
    else if (n == "阿普唑仑") true
    else if (n == "氯硝西泮") true
    else if (n == "劳拉西泮") true
    else if (n == "羟考酮") true
    else if (n == "芬太尼") true
    else if (n == "可待因") true
    else if (n == "哌替啶") true
    else false
fun bioMark(d: Drug): Str = if (estDrug(d.name)) "h · F≈" else "h · F="
fun drugDetail(d: Drug): Str = concat(concat(concat(concat(concat(concat(d.category, " · T½ "), detailHalf(d.pk)), bioMark(d)), detailBio(d.pk)), "% · "), firstRoute(d.pk))

@impure
fun medRowOf(r: DoseRec, drugs: List[Drug]): MedCard {
    unchecked var t: Str = fmtTime(r.time)
    return MedCard(name = r.drug, time = t, route = routeOf(r.drug, drugs), dose = concat(toStr(r.amount), " mg"))
}

@impure
fun medRowsOf(recs: List[DoseRec], drugs: List[Drug]): List[MedCard] =
    map(recs) { r => medRowOf(r, drugs) }

// 记录列表（≈ LazyColumn items：标题 + 卡片序列 + 末尾 96dp 底部留白）。
@composable
fun recordTitle(): Any = Box(modifier = fillWidth().padding4(24, 16, 24, 8)) {
    Text(text = "服药记录", size = 16, bold = true, color = "onSurface")
}

@composable
fun recordList(rows: List[MedCard]): List[Any] = when (rows) {
    Nil => cons(doseEmpty(), emptyList())
    is Cons(c, rest) => cons(doseCard(c), recordList(rest))
    else => emptyList()
}

@composable
fun doseEmpty(): Any = Box(modifier = fillWidth().paddingH(24).paddingV(12), contentAlignment = Center()) {
    Text(text = "暂无服药记录", color = "onSurfaceVariant", size = 14)
}

// 一张记录卡（≈ DoseCard：Card 圆角 12 + elevation 0 + surfaceVariant 底，无阴影）。
// 行内：4×20dp 药色竖条（width(4).height(20) 链）+ Spacer(10) + 药名 weight(1) + 右侧剂量。
@composable
@composable
fun doseCard(c: MedCard): Any = Card(modifier = fillWidth().paddingH(24).paddingV(6), cornerRadius = 12, elevation = 0, backgroundColor = "surfaceVariant", onClick = { unchecked openDocFor(c.name) }) {
    Box(modifier = fillWidth().paddingHV(16, 12)) {
        Box(modifier = fillWidth(), orientation = "horizontal", contentAlignment = CenterStart()) {
            Box(modifier = width(4).height(20).background(drugColor(c.name))) {}
            Box(modifier = width(10)) {}
            Text(text = c.name, modifier = weight(1.0), size = 16, bold = true, color = "onSurface")
            Text(text = c.dose, size = 16, bold = true, color = "primary")
        }
        Box(modifier = height(4)) {}
        Text(text = concat(concat("给药时间 ", c.time), concat(" · ", c.route)), color = "onSurfaceVariant", size = 12)
    }
}

// ---------- 图表数据（≈ ConcentrationChart + PkEngine：t=0 为当前时刻，0..48h 预测） ----------

// 像素 → dp（桥返回 px 与 densityDpi）。
fun toDp(px: Nat, dpi: Nat): Nat = (px * 160) / dpi

// 距当前时刻的小时数（给药时间 - now；已给过的剂量为负，仍计入残量——与参考只排除未来剂量一致）。
fun hourAhead(r: DoseRec, nowMs: Nat): Nat = (r.time - nowMs) / msPerHour()

// 某药的台账剂量序列。
fun dosesOfName(n: Str, recs: List[DoseRec], nowMs: Nat): List[Dose] = when (recs) {
    Nil => emptyList()
    is Cons(r, rest) => if (r.drug == n) cons(Dose(r.amount, hourAhead(r, nowMs)), dosesOfName(n, rest, nowMs)) else dosesOfName(n, rest, nowMs)
    else => emptyList()
}

fun halfOfName(n: Str, drugs: List[Drug]): Nat = when (drugs) {
    Nil => 24
    is Cons(d, rest) => if (d.name == n) halfNat(d.pk) else halfOfName(n, rest)
    else => 24
}
fun bioOfName(n: Str, drugs: List[Drug]): Rat = when (drugs) {
    Nil => 1.0
    is Cons(d, rest) => if (d.name == n) bioRat(d.pk) else bioOfName(n, rest)
    else => 1.0
}

// 某药的分量序列（该药的 T½/F）。
fun seriesOfDrug(n: Str, recs: List[DoseRec], drugs: List[Drug], nowMs: Nat): List[Rat] =
    seriesValues(dosesOfName(n, recs, nowMs), halfOfName(n, drugs), bioOfName(n, drugs), 0, windowHours(), stepHours())

fun seriesOfNames(names: List[Str], recs: List[DoseRec], drugs: List[Drug], nowMs: Nat): List[Series] = when (names) {
    Nil => emptyList()
    is Cons(n, rest) => cons(Series(label = n, color = drugColor(n), points = seriesOfDrug(n, recs, drugs, nowMs)), seriesOfNames(rest, recs, drugs, nowMs))
    else => emptyList()
}

// 图表全部序列（逐药分量线）。空台账 → 氟伏沙明演示序列（home 首启不空图）。
fun chartSeriesList(recs: List[DoseRec], drugs: List[Drug], nowMs: Nat): List[Series] =
    if (size(recentDrugs(recs)) == 0) {
        cons(Series(label = "氟伏沙明", color = "#FFC107", points = seriesValues(demoDoses(), halfNat(fluvoxamine().pk), bioRat(fluvoxamine().pk), 0, windowHours(), stepHours())), emptyList())
    } else {
        seriesOfNames(recentDrugs(recs), recs, drugs, nowMs)
    }

// 总浓度主线 = 逐药分量逐点求和（参考 PkEngine.concentrationAt 的跨药叠加：
// C(t) = Σ_i F_i · D_i · 0.5^((t−t_i)/T½_i)，每药各自 T½/F）。
fun sumSeries(xs: List[Rat], ys: List[Rat]): List[Rat] = when (xs) {
    Nil => ys
    is Cons(a, rest) => when (ys) {
        Nil => xs
        is Cons(b, ysRest) => cons(a + b, sumSeries(rest, ysRest))
        else => xs
    }
    else => ys
}
fun sumAllSeries(xss: List[List[Rat]]): List[Rat] = when (xss) {
    Nil => emptyList()
    is Cons(h, rest) => sumSeries(h, sumAllSeries(rest))
    else => emptyList()
}
fun pointsOf(xss: List[Series]): List[List[Rat]] = when (xss) {
    Nil => emptyList()
    is Cons(s, rest) => cons(s.points, pointsOf(rest))
    else => emptyList()
}
fun totalPoints(seriesXs: List[Series]): List[Rat] = sumAllSeries(pointsOf(seriesXs))

// X 轴刻度：与参考一致每 12h 一个（0/12/24/36/48），其余采样点留空。
fun chartLabels(): List[Str] = map(range(0, (windowHours() / stepHours()) + 1)) { i => tickLabel(i) }
fun tickLabel(i: Nat): Str = if (i % 3 == 0) toStr(i * stepHours()) else ""

// ---------- FAB 与表单（≈ ExtendedFAB + ModalBottomSheet） ----------

@impure
fun toggleForm(): Null {
    unchecked var open: Bool = isFormOpen()
    if (open) {
        unchecked setFormOpen(false)
    } else {
        unchecked setFormOpen(true)
        unchecked setPickUnset()
        unchecked setDose("")
        unchecked setDoseErr("")
    }
    unchecked refreshHome()
    return null
}

@impure
fun pickDrugAt(k: Nat): Null {
    unchecked setPickAt(k)
    unchecked setDoseErr("")
    unchecked refreshHome()
    return null
}

@impure
fun cancelForm(): Null {
    unchecked setFormOpen(false)
    unchecked setPickUnset()
    unchecked setDose("")
    unchecked setDoseErr("")
    unchecked refreshHome()
    return null
}

// 确认：参考四级校验（未选药 / 空非数字 / <=0 / 超上限），失败均 toast 且不关面板。
@impure
fun commitDose(): Null {
    unchecked var ok: Bool = isPickSet()
    unchecked var dt: Str = strTrim(curDose())
    if (ok == false) {
        unchecked setDoseErr("请先选择药物")
        unchecked toast("请先选择药物", false)
    } else {
        if (dt == "") {
            unchecked setDoseErr("剂量必须为数字")
            unchecked toast("剂量必须为数字", false)
        } else {
            if (isNumber(dt) == false) {
                unchecked setDoseErr("剂量必须为数字")
                unchecked toast("剂量必须为数字", false)
            } else {
                var amt: Rat = ratOr(dt, 0.0)
                if (amt <= 0.0) {
                    unchecked setDoseErr("剂量必须大于 0")
                    unchecked toast("剂量必须大于 0", false)
                } else {
                    if (amt > 10000.0) {
                        unchecked setDoseErr("单次剂量不得超过 10000 mg")
                        unchecked toast("单次剂量不得超过 10000 mg", false)
                    } else {
                        unchecked var recs: List[DoseRec] = loadLedger()
                        unchecked var nowMs: Nat = timeNow()
                        unchecked var drugs: List[Drug] = coadmin()
                        unchecked var idx: Nat = curPick()
                        var drug: Str = drugAt(drugs, idx)
                        var nr: List[DoseRec] = cons(DoseRec(drug, amt, nowMs), recs)
                        unchecked saveLedger(nr)
                        unchecked setFormOpen(false)
                        unchecked setPickUnset()
                        unchecked setDoseErr("")
                        unchecked setDose("")
                        unchecked toast("已记录服药，浓度曲线与记录已刷新", false)
                        unchecked refreshHome()
                    }
                }
            }
        }
    }
    return null
}

// 字符串是否为合法数值（校验用：ratOr 的回退会掩盖非数字输入）。
fun isNumber(s: Str): Bool = when (parseRat(s)) {
    is Some(_) => true
    None => false
}

fun drugAt(drugs: List[Drug], n: Nat): Str = when (elementAt(drugs, n)) {
    is Some(d) => d.name
    None => "氟伏沙明"
}

// 表单面板（≈ ModalBottomSheet：BottomSheet 视图，visible 数据字段驱显隐）。
@composable
fun formPanel(open: Bool, drugs: List[Drug], idx: Nat, sel: Bool, dt: Str, de: Str): BottomSheet = BottomSheet(visible = open, onDismiss = { unchecked cancelForm() }) {
    Box(modifier = fillWidth().padding4(24, 0, 24, 24)) {
        Text(text = "＋服用药物", size = 22, bold = true)
        Box(modifier = height(4)) {}
        Text(text = "选择药物并填写剂量（mg）", color = "onSurfaceVariant", size = 12)
        Box(modifier = height(12)) {}
        Text(text = "药物", color = "onSurfaceVariant", size = 14)
        Box(modifier = height(6)) {}
        // 参考的药物列表高 168dp、条间距 6dp：height(168) + spacing，行平铺经 children。
        Box(modifier = fillWidth().height(168), scrollable = true, spacing = 6, children = drugRowsFrom(drugs, 0, idx, sel))
        Box(modifier = height(12)) {}
        TextField(placeholder = "剂量 (mg)", label = "剂量 (mg)", text = dt, keyboard = "number", errText = de,
            onChange = { t => unchecked setDose(t) })
        Box(modifier = height(16)) {}
        Box(modifier = fillWidth(), orientation = "horizontal", arrangement = "End", contentAlignment = CenterStart()) {
            TextButton(label = "取消", onClick = { unchecked cancelForm() })
            Box(modifier = width(8)) {}
            Button(label = "确认", onClick = { unchecked commitDose() })
        }
    }
}

// 药物选择行（≈ Surface(onClick)：整行可点的圆角 12 条，选中 primaryContainer 底 + ✓）。
// 递归生成 → 每行 onClick 经 __dshCb 独立实例键（旧协议串点击 bug 的回归点）。
@composable
fun drugRowsFrom(drugs: List[Drug], k: Nat, idx: Nat, sel: Bool): List[Any] = when (drugs) {
    Nil => emptyList()
    is Cons(d, rest) => cons(drugRow(d, k, idx, sel), drugRowsFrom(rest, k + 1, idx, sel))
    else => emptyList()
}

@composable
fun drugRow(d: Drug, k: Nat, idx: Nat, sel: Bool): Any = Box(modifier = fillWidth().clip(12).background(rowBg(k, idx, sel)).paddingHV(12, 10), orientation = "horizontal", contentAlignment = CenterStart(), onClick = { unchecked pickDrugAt(k) }) {
    Box(modifier = weight(1.0)) {
        Text(text = d.name, size = 16, bold = rowBold(k, idx, sel), color = rowNameColor(k, idx, sel))
        Text(text = drugDetail(d), size = 12, color = "onSurfaceVariant")
    }
    // ⓘ 资料页入口（子节点独立响应点击，不触发选药）。
    Box(modifier = clip(12).paddingHV(8, 6), onClick = { unchecked openDocFor(d.name) }) {
        Text(text = "ⓘ", size = 13, bold = true, color = "onSurfaceVariant")
    }
    // ✓ 恒占位（未选透明 #00000000，等同参考的 if (isSelected) Text("✓") 布局位）。
    Text(text = "✓", size = 16, bold = true, color = rowCheckColor(k, idx, sel))
}

fun rowBg(k: Nat, idx: Nat, sel: Bool): Str = if ((sel == true) && (k == idx)) "primaryContainer" else "surfaceVariant"
fun rowNameColor(k: Nat, idx: Nat, sel: Bool): Str = if ((sel == true) && (k == idx)) "onPrimaryContainer" else "onSurface"
fun rowCheckColor(k: Nat, idx: Nat, sel: Bool): Str = if ((sel == true) && (k == idx)) "primary" else "#00000000"
fun rowBold(k: Nat, idx: Nat, sel: Bool): Bool = (sel == true) && (k == idx)

// ---------- 设置/文档弹层（≈ SettingsDialog / DrugDocsDialog：AlertDialog） ----------

// 药库名单（顶栏 info/menu 入口）：18 药索引 → 点药名开该药资料页。
@impure
fun openDrugList(): Null {
    unchecked setListOpen(true)
    unchecked refreshHome()
    return null
}
@impure
fun closeDrugList(): Null {
    unchecked setListOpen(false)
    unchecked refreshHome()
    return null
}
@impure
fun openDocFor(n: Str): Null {
    unchecked setDocName(n)
    unchecked setListOpen(false)
    unchecked refreshHome()
    return null
}
@impure
fun closeDoc(): Null {
    unchecked setDocName("")
    unchecked refreshHome()
    return null
}
@impure
fun openSettingsDialog(): Null {
    unchecked setSettingsOpen(true)
    unchecked refreshHome()
    return null
}
@impure
fun closeSettings(): Null {
    unchecked setSettingsOpen(false)
    unchecked refreshHome()
    return null
}
@impure
fun clearAll(): Null {
    unchecked saveLedger(emptyList())
    unchecked setSettingsOpen(false)
    unchecked refreshHome()
    return null
}

@composable
fun settingsDialog(open: Bool): AlertDialog = AlertDialog(visible = open, title = "设置", confirmText = "清空记录", dismissText = "关闭", onConfirm = { unchecked clearAll() }, onDismiss = { unchecked closeSettings() }) {
    Text(text = "语法糖手册 V1.0\nSfA（Sublimation for Android）视图协议 v2 渲染\n数据持久化：storage 键 ledger", size = 12, color = "onSurfaceVariant")
}

// ---------- 药库名单与药物资料页（替代原写死共用 docDialog） ----------

// 按名取药（资料页与链路计算用）。
fun drugByName(n: Str, xs: List[Drug]): Drug = when (xs) {
    is Cons(d, rest) => if (d.name == n) d else drugByName(n, rest)
    else => fluvoxamine()
}

// 药库名单行（Box > 药色竖条 + 名 + 副标题），点行开资料页。
@composable
fun drugListRow(d: Drug): Any = Box(modifier = fillWidth().clip(12).background("surfaceVariant").paddingHV(12, 10), orientation = "horizontal", contentAlignment = CenterStart(), onClick = { unchecked openDocFor(d.name) }) {
    Box(modifier = width(4).height(20).background(drugColor(d.name))) {}
    Box(modifier = width(10)) {}
    Box(modifier = weight(1.0)) {
        Text(text = d.name, size = 15, bold = true, color = "onSurface")
        Text(text = drugDetail(d), size = 11, color = "onSurfaceVariant")
    }
}
@composable
fun drugListRows(xs: List[Drug]): List[Any] = when (xs) {
    Nil => emptyList()
    is Cons(d, rest) => cons(drugListRow(d), drugListRows(rest))
    else => emptyList()
}

// 药库名单抽屉（纯说明放头部，不再有按药写死的共用文本）。
@composable
fun drugListSheet(open: Bool, drugs: List[Drug]): BottomSheet = BottomSheet(visible = open, onDismiss = { unchecked closeDrugList() }) {
    Box(modifier = fillWidth().padding4(24, 0, 24, 24)) {
        Text(text = "药库名单", size = 22, bold = true)
        Box(modifier = height(4)) {}
        Text(text = "糖手册：记录服药 → 估算血药浓度 → 呼吸抑制风险预警。点击药名查看该药完整资料；相互作用链复用 metabAlert 匹配逻辑。\n源码：github.com/inline-function/Sugar-Manual", color = "onSurfaceVariant", size = 12)
        Box(modifier = height(12)) {}
        Box(modifier = fillWidth().height(320), scrollable = true, spacing = 6, children = drugListRows(drugs))
    }
}

// ---- 资料页内容 ----

// 标签条（含【超说明书】黄色标记）。
fun inOffLabel(s: Str): Bool = when (strIndexOf(s, "超说明书")) {
    is Some(_) => true
    None => false
}
@composable
fun tagChip(s: Str): Any = Box(modifier = clip(12).paddingHV(10, 4), backgroundColor = if (inOffLabel(s)) "primaryContainer" else "surfaceVariant") {
    Text(text = s, size = 11, color = "onSurfaceVariant")
}
@composable
fun tagChips(ts: List[Str]): List[Any] = when (ts) {
    Nil => emptyList()
    is Cons(s, rest) => cons(tagChip(s), tagChips(rest))
    else => emptyList()
}
@composable
fun docHeader(d: Drug): Any = Box(modifier = fillWidth(), orientation = "vertical", spacing = 6) {
    Text(text = d.name, size = 22, bold = true, color = "onSurface")
    Text(text = d.category, size = 12, color = "onSurfaceVariant")
    Box(modifier = fillWidth(), wrap = true, spacing = 6, children = tagChips(d.tags))
}

// Rated 条目分级配色（复用 tagFg 调色板）。
fun advFreqLevel(level: Str): Nat = if (level == "十分常见") 3 else if (level == "常见") 2 else if (level == "少见") 1 else 0
fun therColor(level: Str): Str = if (level == "极强") "primary" else if (level == "强效") "primary" else if (level == "强") "primary" else if (level == "极弱") "onSurfaceVariant" else "onSurface"
@composable
fun ratedRow(r: Rated, kind: Nat): Any = when (kind) {
    // 0=疗效/药效 1=不良反应(频次配色) 2=过量(红+闪烁) 3=酶抑制(强度配色)
    0 => Text(text = concat(concat(r.level, " · "), r.name), size = 13, color = therColor(r.level))
    1 => Text(text = concat(concat(r.level, " · "), r.name), size = 13, color = tagFg(advFreqLevel(r.level), false))
    2 => Text(text = concat(concat(r.level, " · "), r.name), size = 13, bold = true, color = tagFg(0, true), flash = true)
    else => Text(text = concat(concat(r.level, " · "), r.name), size = 13, color = therColor(r.level))
    else => Text(text = concat(concat(r.level, " · "), r.name), size = 13, color = "onSurface")
}
@composable
fun ratedRows(xs: List[Rated], kind: Nat): List[Any] = when (xs) {
    Nil => emptyList()
    is Cons(r, rest) => cons(ratedRow(r, kind), ratedRows(rest, kind))
    else => emptyList()
}
@composable
fun docSection(title: Str, xs: List[Rated], kind: Nat): Any = if (size(xs) == 0) Box(modifier = fillWidth()) {} else Box(modifier = fillWidth(), orientation = "vertical", spacing = 4) {
    Text(text = title, size = 13, bold = true, color = "primary")
    Box(modifier = fillWidth(), children = ratedRows(xs, kind))
}
@composable
fun inhibTextNode(d: Drug): Any = Box(modifier = fillWidth()) {
    if (inhibLine(d) != "") {
        Text(text = inhibLine(d), size = 13, color = "onSurface")
    }
}

// 药动学：途径 · 剂型 · T½ · Tmax · F（F≈ 估算标记）+ 代谢物。
fun headProfile(pk: List[PkProfile]): PkProfile = when (pk) {
    is Cons(p, _) => p
    else => PkProfile(route = "口服", form = "常释", halfLife = 24, tmax = "-", clearance = "-", curve = "对数", bio = 1.0, metabolites = emptyList())
}
fun pkLine(d: Drug): Str = when (d.pk) {
    is Cons(p, _) => joinTexts(pkParts(p, d), " · ")
    else => "药动学缺失"
}
fun pkParts(p: PkProfile, d: Drug): List[Str] = cons(concat("途径 ", p.route),
    cons(concat("剂型 ", p.form),
    cons(concat("T½ ", concat(toStr(p.halfLife), "h")),
    cons(concat("Tmax ", p.tmax),
    cons(concat(bioMarkOf(d), bioPctOf(p, d)), emptyList())))))
fun bioMarkOf(d: Drug): Str = if (estDrug(d.name)) "F≈" else "F="
fun bioPctOf(p: PkProfile, d: Drug): Str = if (estDrug(d.name)) concat(toStr(p.bio * 100.0), "%（估算）") else concat(toStr(p.bio * 100.0), "%")
@composable
fun pkSection(d: Drug): Any = Box(modifier = fillWidth(), orientation = "vertical", spacing = 4) {
    Text(text = "药动学", size = 13, bold = true, color = "primary")
    Text(text = pkLine(d), size = 13, color = "onSurface")
    Box(modifier = fillWidth(), children = ratedRows(headProfile(d.pk).metabolites, 3))
}

// 相互作用：抑制酶、经酶代谢、该药参与的 CYP 链（复用 warn 的 relatesTo 匹配）。
fun inhibLine(d: Drug): Str = when (d.inhibitions) {
    Nil => ""
    is Cons(r, _) => concat("抑制：", joinRatedNames(d.inhibitions))
    else => ""
}
fun joinRatedNames(xs: List[Rated]): Str = when (xs) {
    Nil => ""
    is Cons(r, Nil) => concat(concat(r.level, " "), r.name)
    is Cons(r, rest) => concat(concat(concat(r.level, " "), r.name), concat("；", joinRatedNames(rest)))
    else => ""
}
fun joinNames(xs: List[Str]): Str = when (xs) {
    Nil => ""
    is Cons(a, Nil) => a
    is Cons(a, rest) => concat(a, concat("、", joinNames(rest)))
    else => ""
}
// 该酶的联用伙伴（除自身）：抑制者（带级别）与底物。
fun partnerName(d2: Drug, e: Str): Str = if (containsRated(d2.inhibitions, e)) concat(d2.name, concat("（", concat(inhibWeightText(d2.inhibitions, e), "抑制）"))) else if (contains(d2.enzymes, e)) concat(d2.name, "（底物）") else ""
fun inhibWeightText(xs: List[Rated], e: Str): Str = when (xs) {
    Nil => ""
    is Cons(r, rest) => if (r.name == e) r.level else inhibWeightText(rest, e)
    else => ""
}
@composable
fun cypChainRow(e: Str, self: Drug, drugs: List[Drug]): Any = Text(text = concat(concat(e, " 链："), partnersText(drugs, e, self)), size = 12, color = "onSurfaceVariant")
fun partnersText(drugs: List[Drug], e: Str, self: Drug): Str = joinTexts(partnerNames(drugs, e, self), " · ")
fun partnerNames(drugs: List[Drug], e: Str, self: Drug): List[Str] = when (drugs) {
    Nil => emptyList()
    is Cons(d2, rest) => if (d2.name == self.name) partnerNames(rest, e, self) else if (relatesTo(d2, e)) cons(partnerName(d2, e), partnerNames(rest, e, self)) else partnerNames(rest, e, self)
    else => emptyList()
}
fun joinTexts(xs: List[Str], sep: Str): Str = when (xs) {
    Nil => ""
    is Cons(a, rest) => if (size(rest) == 0) a else concat(a, concat(sep, joinTexts(rest, sep)))
    else => ""
}
fun chainEnzymes(d: Drug): List[Str] = append(inhibNames(d.inhibitions), d.enzymes)
@composable
fun chainRows(es: List[Str], self: Drug, drugs: List[Drug]): List[Any] = when (es) {
    Nil => emptyList()
    is Cons(e, rest) => if (partnersText(drugs, e, self) == "") chainRows(rest, self, drugs) else cons(cypChainRow(e, self, drugs), chainRows(rest, self, drugs))
    else => emptyList()
}
@composable
fun interactSection(d: Drug, drugs: List[Drug]): Any = Box(modifier = fillWidth(), orientation = "vertical", spacing = 4) {
    Text(text = "相互作用（CYP450 链）", size = 13, bold = true, color = "primary")
    inhibTextNode(d)
    Text(text = concat("经酶代谢：", joinNames(d.enzymes)), size = 13, color = "onSurface")
    Box(modifier = fillWidth(), children = chainRows(chainEnzymes(d), d, drugs))
}

// 药物资料页抽屉：头部 + 描述 + 分段 Rated 清单 + 药动 + 相互作用链。
@composable
fun docSheetPage(name: Str, drugs: List[Drug]): BottomSheet = BottomSheet(visible = name != "", onDismiss = { unchecked closeDoc() }) {
    Box(modifier = fillWidth().padding4(24, 0, 24, 24)) {
        if (name != "") {
            docPageBody(drugByName(name, drugs), drugs)
        }
    }
}

@composable
fun docPageBody(d: Drug, drugs: List[Drug]): Any = Box(modifier = fillWidth().height(520), scrollable = true, orientation = "vertical", spacing = 10) {
    docHeader(d)
    Text(text = d.description, size = 12, color = "onSurfaceVariant")
    docSection("药效", d.effects, 0)
    docSection("酶抑制", d.inhibitions, 3)
    docSection("急性期疗效", d.acuteTher, 0)
    docSection("维持期疗效", d.chronicTher, 0)
    docSection("急性不良反应", d.acuteAdv, 1)
    docSection("慢性不良反应", d.chronicAdv, 1)
    docSection("停药反应", d.withdraw, 1)
    docSection("过量（危险剂量）", d.overdose, 2)
    pkSection(d)
    interactSection(d, drugs)
}

// ---------- 主界面（≈ Scaffold content） ----------

// 首屏分区：内容区 = 屏高 - 顶栏 64dp；图占 45%，下半区精确补齐 55%（参考
// fillMaxHeight(0.45f) + LazyColumn(weight(1f)) 的_partition，旧协议 45+50 留 5% 空隙）。
fun contentHeightDp(sh: Nat, dpi: Nat): Nat = toDp(sh, dpi) - 64
fun chartHeightDp(sh: Nat, dpi: Nat): Nat = (contentHeightDp(sh, dpi) * 45) / 100
fun lowerHeightDp(sh: Nat, dpi: Nat): Nat = contentHeightDp(sh, dpi) - chartHeightDp(sh, dpi)

@composable
fun lowerBox(rs: Alert, rows: List[MedCard], drugs: List[Drug], met: Alert, sh: Nat, dpi: Nat): Box = Box(modifier = fillWidth().height(lowerHeightDp(sh, dpi)), scrollable = true) {
    respStream(rs)
    metabStream(met)
    recordTitle()
    // 记录卡平铺为直接子级（children=），空台账给「暂无服药记录」占位。
    Box(modifier = fillWidth(), children = recordList(rows))
    // 参考的 contentPadding(bottom = 96.dp)。
    Box(modifier = height(96)) {}
}

@composable
fun content(): Box {
    unchecked var open: Bool = isFormOpen()
    unchecked var setOp: Bool = isSettingsOpen()
    unchecked var docN: Str = docName()
    unchecked var listOp: Bool = isListOpen()
    unchecked var idx: Nat = curPick()
    unchecked var sel: Bool = isPickSet()
    unchecked var dt: Str = curDose()
    unchecked var de: Str = doseErr()
    unchecked @mut var recs: List[DoseRec] = loadLedger()
    unchecked @mut var nowMs: Nat = timeNow()
    unchecked var drugs: List[Drug] = coadmin()
    unchecked var drugsOf: List[Drug] = coadminOf(recs)
    var rs: Alert = respAlert(drugsOf)
    var met: Alert = metabAlert(drugs)
    unchecked var sh: Nat = screenHeight()
    unchecked var dpi: Nat = screenDensity()
    var seriesXs: List[Series] = chartSeriesList(recs, drugs, nowMs)
    var total: List[Rat] = totalPoints(seriesXs)
    @mut var chart = Chart(kind = "line", points = total, series = seriesXs, labels = chartLabels(), color = "primary", legend = true, badge = "估算", modifier = fillWidth().height(chartHeightDp(sh, dpi)))
    unchecked var rows: List[MedCard] = medRowsOf(recs, drugs)
    @mut var lower = lowerBox(rs, rows, drugs, met, sh, dpi)
    @mut var sheet = formPanel(open, drugs, idx, sel, dt, de)
    @mut var setDlg = settingsDialog(setOp)
    @mut var listSheet = drugListSheet(listOp, drugs)
    @mut var docSheet = docSheetPage(docN, drugs)
    return Box(modifier = fillMaxSize()) {
        topBar()
        chart
        lower
        FloatingButton(icon = "add", text = "＋服用药物", color = "primary", onClick = { unchecked toggleForm() })
        sheet
        setDlg
        listSheet
        docSheet
    }
}
