// app/main.subl —— 语法糖手册主界面（MD 风格三段式 + 悬浮按钮）
//
// 布局：顶栏（标题 + 版本副标题 + 文档/设置按钮）/ 上：浓度折线图（Chart）
// / 中：预警栏（三级差异化着色）/ 下：药品列表（按最近服药时间）/ 右下：
// 「服用药物」悬浮圆角按钮（FloatingButton）——记录服药后刷新曲线、列表与
// 预警，并持久化到 storage 键 "ledger"。
//
// 数据层：drugs.subl（药物资料模型+药库）、warn.subl（预警引擎）、pk.subl
//（药代动力学）、fluvoxamine.subl / interact.subl（资料数据）、ledger.subl
//（服药台账）。视图：标准库 @view 结构体（Chart/FloatingButton 为本任务新增）。

// ---------- 演示剂量（空台账回退用：常释 100mg × 2 次，间隔 24h） ----------

fun demoDoses(): List[Dose] = cons(Dose(100.0, 0), cons(Dose(100.0, 24), emptyList()))

// ---------- 示例联用集（引擎评估用） ----------

// 用户药库（storage 持久化）+ 预置示例资料。
@impure
fun coadmin(): List[Drug] = append(loadDrugs(), cons(fluvoxamine(), cons(paroxetine(), emptyList())))

// ---------- 生命周期 ----------

@impure
fun main(): Null {
    onCreate {
        unchecked log("Sugar Manual 已加载", 2)
    }
    onStart {
        layout(content)
    }
}

// ---------- 顶栏 ----------

fun versionText(): Str = "V1.0"

@impure
fun openDoc(): Null {
    unchecked openUrl("https://github.com/inline-function/Sugar-Manual")
    null
}

// ---------- 预警着色与文案 ----------

// MD 色板：3=危险红、2=警告橙、1=提示蓝、0=无预警绿。
fun levelBg(l: Nat): Str = when (l) {
    3 => "#FDECEA"
    2 => "#FFF3E0"
    1 => "#E3F2FD"
    else => "#F5F5F5"
}
fun levelFg(l: Nat): Str = when (l) {
    3 => "#B3261E"
    2 => "#E65100"
    1 => "#1565C0"
    else => "#616161"
}

fun bannerHead(adr: Alert, metab: Alert): Str =
    concat(concat(concat("不良反应：", levelName(adr.level)), " · 代谢："), levelName(metab.level))

// ---------- 跟踪药物的药代参数（无资料回退 T½=24h、F=1） ----------

fun trackHalfLife(): Nat = when (fluvoxamine().pk) {
    is Cons(p, _) => p.halfLife
    Nil => 24
}
fun trackBio(): Rat = when (fluvoxamine().pk) {
    is Cons(p, _) => p.bio
    Nil => 1.0
}

fun chartPoints(doses: List[Dose]): List[Rat] =
    seriesValues(doses, trackHalfLife(), trackBio(), 0, windowHours(), stepHours())

// ---------- 主界面 ----------

@composable
fun content(): Box {
    unchecked @mut var recs: List[DoseRec] = loadLedger()
    unchecked @mut var nowMs: Nat = timeNow()
    @mut var doses: List[Dose] = ledgerDoses(recs, nowMs)
    unchecked var drugs: List[Drug] = coadmin()
    var adr: Alert = adrAlert(drugs)
    var metab: Alert = metabAlert(drugs)
    @mut var vals: List[Rat] = chartPoints(doses)
    @mut var labels: List[Str] = seriesLabels(0, windowHours(), stepHours())
    @mut var chart = Chart(kind = "line", points = vals, labels = labels, color = "#6750A4")
    @mut var banner = bannerBody(adr, metab)
    unchecked @mut var rows: List[Str] = medRowsText(recs)
    @mut var medList = medRowsBody(rows)
    return Box(modifier = Plain()) {
        // 顶栏：标题 + 版本副标题 + 文档/设置
        Box(modifier = Plain(), orientation = "horizontal") {
            Box(modifier = Plain()) {
                Text(text = "语法糖手册", size = 20, bold = true)
                Text(text = versionText(), color = "#9E9E9E", size = 12)
            }
            Button(onClick = { unchecked openDoc() }) {
                Text(text = "文档")
            }
            Button(onClick = { unchecked openSettings() }) {
                Text(text = "设置")
            }
        }
        // 上：估算血药浓度折线
        Box(modifier = Plain()) { chart }
        // 中：预警栏
        Box(modifier = Plain()) { banner }
        // 下：药品列表（按最近服药时间从上到下）
        Box(modifier = Plain()) { medList }
        // 右下：悬浮圆角按钮
        FloatingButton(onClick = {
            unchecked nowMs = timeNow()
            unchecked recs = cons(DoseRec(recentDrug(recs), 100.0, nowMs), recs)
            unchecked saveLedger(recs)
            doses = ledgerDoses(recs, nowMs)
            vals = chartPoints(doses)
            chart = Chart(kind = "line", points = vals, labels = labels, color = "#6750A4")
            unchecked rows = medRowsText(recs)
            medList = medRowsBody(rows)
            unchecked toast("已记录服药，浓度曲线已刷新", false)
        }) {
            Text(text = "＋ 服用药物")
        }
    }
}

// ---------- 预警栏 ----------

@composable
fun bannerBody(adr: Alert, metab: Alert): Box = when (maxAlertLevel(adr, metab)) {
    0 => Box(modifier = Plain(), backgroundColor = "#E8F5E9") {
        Text(text = "暂无联用预警", color = "#2E7D32", size = 14)
    }
    else => Box(modifier = Plain(), backgroundColor = levelBg(maxAlertLevel(adr, metab))) {
        Text(text = concat("⚠ ", bannerHead(adr, metab)), color = levelFg(maxAlertLevel(adr, metab)), size = 15, bold = true)
        triggerRows(append(adr.items, metab.items))
    }
}

// ---------- 药品列表 ----------

// 台账 -> 行文本（药名 剂量mg · 时间）。@impure 因 fmtTime（平台内建）。
@impure
fun medRowsText(recs: List[DoseRec]): List[Str] = map(recs) { r => medRowText(r) }

@impure
fun medRowText(r: DoseRec): Str {
    unchecked var t: Str = fmtTime(r.time)
    return concat(concat(concat(concat(r.drug, "  "), toStr(r.amount)), "mg · "), t)
}

@composable
fun medRowsBody(rows: List[Str]): Any = when (rows) {
    Nil => Box(modifier = Plain()) {
        Text(text = "尚无服药记录，点击右下「服用药物」开始", color = "#9E9E9E", size = 13)
    }
    is Cons(m, rest) => Box(modifier = Plain()) {
        Text(text = m, size = 15)
        medRowsBody(rest)
    }
}

// ---------- 兼容：预警摘要行（t28 引擎层验收用） ----------

fun summaryLine(adr: Alert, metab: Alert): Str =
    concat(concat(concat("不良反应：", levelName(adr.level)), concat("  代谢：", levelName(metab.level))), "（演示联用）")

// 预警触发项清单：每行「名称  权重」。
@composable
fun triggerRows(ts: List[Trigger]): Box = Box(modifier = Plain()) {
    triggerBody(reverse(ts))
}

@composable
fun triggerBody(xs: List[Trigger]): Any = when (xs) {
    Nil => Box(modifier = Plain()) {}
    is Cons(t, rest) => Box(modifier = Plain()) {
        Text(text = concat(concat(t.name, "  权重 "), toStr(t.score)), size = 13)
        triggerBody(rest)
    }
}
