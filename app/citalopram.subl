// app/citalopram.subl —— 西酞普兰完整资料
// 数值来源：西酞普兰药品说明书与综述。halfLife=35h（说明书均值）、bio=0.8（说明书约 80%）。

fun citalopram(): Drug = Drug(
    name = "西酞普兰",
    category = "处方药",
    tags = strList("选择性血清素再摄取抑制剂,SSRIs,五朵金花,抗抑郁药,抗焦虑药"),
    description = "西酞普兰是酞酐类 SSRI 消旋体，5-HT 再摄取抑制活性集中于左旋异构体（即艾司西酞普兰）。用于抑郁症与各类焦虑障碍。对 CYP 酶抑制极弱、药物相互作用少，适合多药联用与老年患者；但剂量依赖性 QT 间期延长明确，成人最大日剂量 40 mg，【超说明书】高剂量须评估电解质与心电监测。经 CYP3A4 与 CYP2C19（次要 CYP2D6）代谢为弱活性去甲西酞普兰。",
    effects = ratedList("强效|血清素转运体抑制（左旋体）;极弱|正肾素转运体抑制"),
    enzymes = strList("CYP3A4,CYP2C19,CYP2D6"),
    inhibitions = ratedList("极弱|CYP2D6可逆性抑制"),
    pk = cons(PkProfile(
        route = "口服", form = "常释", halfLife = 35, tmax = "4h",
        clearance = "一级", curve = "对数", bio = 0.8,
        metabolites = cons(Rated("极弱", "去甲西酞普兰"), emptyList())
    ), emptyList()),
    acuteTher = ratedList("弱效|镇静"),
    chronicTher = ratedList("极强|抗抑郁;强效|抗焦虑"),
    acuteAdv = ratedList("罕见|血清素综合征"),
    chronicAdv = ratedList("十分常见|恶心;常见|嗜睡;常见|失眠;常见|出汗;常见|口干;常见|性功能障碍;常见|头晕;少见|QT间期延长（剂量依赖）;少见|低血钠症;少见|自杀冲动"),
    withdraw = ratedList("常见|头晕;常见|失眠;常见|恶心;常见|焦虑;少见|电击样感觉"),
    overdose = ratedList(">400mg|心律失常（QT延长）;>600mg|血清素综合征")
)
