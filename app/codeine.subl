// app/codeine.subl —— 可待因完整资料
// 数值来源：药品说明书与综述。halfLife=3h（2.5-4h）、tmax 约 1h；
// bio=0.6 为常引用范围（约 40-70%）中值——绝对生物利用度未在说明书给出，标注为估算中值。
// 镇痛依赖 CYP2D6 转化为吗啡。

fun codeine(): Drug = Drug(
    name = "可待因",
    category = "处方药",
    tags = strList("阿片类,弱阿片镇痛药,镇咳药,前体药,麻醉药品（管制）"),
    description = "可待因是天然阿片生物碱、弱 μ 阿片受体激动剂，本身活性低，镇痛效应主要依赖 CYP2D6 将约 5-10% 转化为吗啡。用于轻中度疼痛与干咳（中国含可待因镇咳复方曾广泛使用，现严格管控）。与 CYP2D6 强抑制剂（帕罗西汀、氟西汀）合用可几乎消除其镇痛效应（联用即警示）；与苯二氮卓类、乙醇合用呼吸抑制风险增加；CYP2D6 慢代谢者镇痛无效。哺乳期妇女禁用（转化为吗啡可致婴儿呼吸抑制）。",
    effects = ratedList("弱效|μ-阿片受体激动（前体，需 CYP2D6 转化吗啡）;中效|咳嗽中枢抑制"),
    enzymes = strList("CYP2D6,CYP3A4,UGT2B7"),
    inhibitions = emptyList(),
    pk = cons(PkProfile(
        route = "口服", form = "常释", halfLife = 3, tmax = "1h",
        clearance = "一级（CYP2D6 与 UGT）", curve = "对数", bio = 0.6,
        metabolites = cons(Rated("强效", "吗啡（CYP2D6 转化，量约 10%）"), cons(Rated("极弱", "去甲可待因"), emptyList()))
    ), emptyList()),
    acuteTher = ratedList("中效|镇痛（轻中度）;强效|镇咳（干咳）"),
    chronicTher = ratedList("中效|镇痛（轻中度疼痛）;中效|镇咳（限无痰干咳）"),
    acuteAdv = ratedList("少见|呼吸抑制;常见|嗜睡;常见|恶心呕吐;常见|欣快"),
    chronicAdv = ratedList("常见|嗜睡;常见|恶心;少见|呼吸抑制"),
    withdraw = ratedList("常见|阿片戒断综合征（骤停）;常见|焦虑;常见|出汗;常见|失眠"),
    overdose = ratedList(">120mg|呼吸抑制")
)
