// android/FloatingButton.subl —— 悬浮圆角按钮（MD FAB，android doc/安卓标准库.md §悬浮按钮）
//
// MD 风格的浮动操作按钮：圆角实心色块，悬浮于父容器右下角（KT 端把含
// FloatingButton 子视图的 Box 渲染为 FrameLayout，FAB 按底部居右重力放置）。
// 协议 v2：icon 为内置图标名（见 Icon.subl；空串 = 无图标），text 为文字（空串 = 纯图标 FAB）。
//   - icon 与 text 都有 = ExtendedFAB（图标 + 文字）
//   - 只有 icon      = 圆形 FAB
// color 为主色（"#RRGGBB" / 主题色名，默认 MD 紫）；cornerRadius 为圆角半径（dp，28 ≈ 正圆角）；
// onClick 为点击回调（协议 v2 实例键）。
//
// KT 端渲染协议（tag = "FloatingButton"）：MaterialButton + cornerRadius + backgroundTint + 内置图标。

@view struct FloatingButton(
    label: Str = "",
    color: Str = "#6750A4",
    cornerRadius: Nat = 28,
    icon: Str = "",
    text: Str = "",
    onClick: (Any) => Null = fun(_: Any): Null { null },
    modifier: List[MKind] = emptyList(),
    body: () => Null = fun(): Null { null }
)
