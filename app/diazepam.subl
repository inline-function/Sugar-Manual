// app/diazepam.subl —— 地西泮完整资料
// 数值来源：地西泮药品说明书与综述。halfLife=36h（20-50h 范围）、bio=0.9（口服吸收接近完全，
// 约 85-95%）；活性代谢物去甲地西泮半衰期 40-100h。

fun diazepam(): Drug = Drug(
    name = "地西泮",
    category = "处方药",
    tags = strList("苯二氮卓类,抗焦虑药,催眠药,抗癫痫药,镇静药,肌肉松弛药"),
    description = "地西泮是长效 1,4-苯二氮卓类，增强 GABA-A 受体介导的抑制性传导。用于焦虑症、酒精戒断综合征、肌肉痉挛、麻醉前给药与癫痫持续状态（静脉注射）。口服吸收快而接近完全，血浆蛋白结合率高（约 98%），经 CYP3A4 与 CYP2C19 氧化为活性代谢物去甲地西泮（半衰期 40-100 小时），反复给药后蓄积明显、次日宿醉感重。与阿片类镇痛药或乙醇合用可产生严重呼吸抑制乃至致死（FDA 黑框警告），长期使用产生耐受、依赖与戒断综合征。",
    effects = ratedList("强效|GABA-A受体苯二氮卓位点变构调节;强效|边缘系统抑制（抗焦虑）;中效|脊髓反射抑制（肌肉松弛）"),
    enzymes = strList("CYP3A4,CYP2C19"),
    inhibitions = emptyList(),
    pk = cons(PkProfile(
        route = "口服", form = "常释", halfLife = 36, tmax = "1-1.5h",
        clearance = "一级（肝氧化代谢）", curve = "对数", bio = 0.9,
        metabolites = cons(Rated("强效", "去甲地西泮（活性，半衰期 40-100h）"), emptyList()),
  // 无临床意义可估算的活性代谢物（展示段 metabolites 仅供资料页说明，不建模）。
        activeForms = emptyList()
    ), emptyList()),
    acuteTher = ratedList("强效|镇静;强效|抗焦虑（快速起效）"),
    chronicTher = ratedList("强效|抗焦虑;强效|抗癫痫（持续状态首选静注）;强效|酒精戒断;中效|肌肉松弛"),
    acuteAdv = ratedList("少见|呼吸抑制;常见|嗜睡;常见|头晕"),
    chronicAdv = ratedList("十分常见|嗜睡;常见|头晕;常见|疲劳;常见|共济失调;常见|顺行性记忆损害;少见|呼吸抑制;少见|反常兴奋"),
    withdraw = ratedList("常见|焦虑反跳;常见|失眠反跳;常见|震颤;常见|出汗;少见|骤停高剂量癫痫发作;少见|感知异常"),
    overdose = ratedList(">100mg|呼吸抑制")
)
