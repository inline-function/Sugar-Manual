// app/naloxone.subl —— 逆转剂条目（t79 rev2）

fun naloxone(): Drug = Drug(
    name = "纳洛酮",
    category = "逆转剂",
    tags = strList("逆转剂，μ受体竞争性拮抗剂"),
    description = "纳洛酮为阿片受体竞争性拮抗剂（μ/κ/δ），用于逆转阿片类过量所致呼吸抑制与意识抑制。起效快（静脉/肌肉 2-3 分钟、鼻喷 2-5 分钟），血浆半衰期短于多数阿片激动剂，作用消退后中毒可复现，必要时重复给药。对阿片依赖者可诱发急性戒断。常用量 0.4 mg（鼻喷/IM）。",
    effects = ratedList("强效|μ/κ/δ阿片受体竞争性拮抗"),
    enzymes = strList("UGT2B7（葡糖醛酸结合）"),
    inhibitions = emptyList(),
    pk = cons(PkProfile(
        route = "鼻喷/注射", form = "常释", halfLife = 1, tmax = "0.1h",
        clearance = "一级", curve = "对数", bio = 1,
        metabolites = emptyList(),
        activeForms = emptyList()
    ), emptyList()),
    acuteTher = ratedList("强效|逆转阿片类呼吸抑制与意识抑制"),
    chronicTher = emptyList(),
    acuteAdv = ratedList("十分常见|戒断反应（阿片依赖者）;常见|恶心;常见|心动过速"),
    chronicAdv = emptyList(),
    withdraw = emptyList(),
    overdose = emptyList(),
    admin = "口服"
)
